# Cloudflare Pages - 보안 및 캐싱 헤더
# https://developers.cloudflare.com/pages/configuration/headers/

# ============================================================================
# 전역 보안 헤더
# ============================================================================
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://apis.google.com https://www.google.com https://www.gstatic.com https://www.googletagmanager.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.supabase.co https://*.googleapis.com https://*.googleusercontent.com https://www.gstatic.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://*.googleapis.com https://*.sentry.io https://*.ingest.sentry.io https://u.expo.dev https://www.google-analytics.com https://www.googletagmanager.com https://cloudflareinsights.com https://www.google.com; frame-src 'self' https://accounts.google.com https://www.google.com; object-src 'none'; base-uri 'self'

# ============================================================================
# 정적 에셋 캐싱 (JS, CSS, 이미지 등)
# ============================================================================
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable

# ============================================================================
# HTML 문서 - 항상 최신 확인
# ============================================================================
/index.html
  Cache-Control: no-cache, no-store, must-revalidate

# 서비스 워커 - 캐싱하지 않음
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# ============================================================================
# Well-Known - 딥링크 검증 파일
# ============================================================================
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=3600

/.well-known/assetlinks.json
  Content-Type: application/json
  Cache-Control: public, max-age=3600

# ============================================================================
# 공개 대회 뷰 - 검색엔진 색인 차단 (F2-① 악용 방어, 전면 개방 대비)
# ============================================================================
# app/+html.tsx 신설 대신 헤더 방식 채택: Expo Router는 SPA 단일 진입점이라
# +html.tsx에 noindex를 넣으면 앱 전체 <head>가 오염됨. _headers는 경로별로
# 격리되어 /monitor·/live 에만 적용되고 빌드 시 dist/ 로 자동 복사됨.
/monitor/*
  X-Robots-Tag: noindex

/live/*
  X-Robots-Tag: noindex
