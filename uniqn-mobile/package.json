{
  "name": "uniqn-mobile",
  "version": "1.0.5",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx}\" \"app/**/*.{ts,tsx,js,jsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx}\" \"app/**/*.{ts,tsx,js,jsx}\"",
    "type-check": "tsc --noEmit",
    "knip": "knip",
    "knip:gate": "knip --max-issues=2189",
    "check:rpc-migrations": "node scripts/check-rpc-migrations.js",
    "quality": "node scripts/check-css-vars-sync.js && npm run check:rpc-migrations && npm run type-check && npm run lint && npm run format:check",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:db:helpers": "docker cp supabase/fixtures/jpc_helpers.sql supabase_db_uniqn:/tmp/jpc_helpers.sql && docker exec supabase_db_uniqn psql -U postgres -d postgres -f /tmp/jpc_helpers.sql && docker cp supabase/fixtures/ops_helpers.sql supabase_db_uniqn:/tmp/ops_helpers.sql && docker exec supabase_db_uniqn psql -U postgres -d postgres -f /tmp/ops_helpers.sql",
    "test:db": "npm run test:db:helpers && npx supabase test db",
    "db:start": "npx supabase start",
    "db:stop": "npx supabase stop",
    "db:status": "npx supabase status",
    "db:reset": "npx supabase db reset",
    "prepare": "node ../scripts/setup-git-hooks.js",
    "build:web": "expo export -p web",
    "build:android": "expo prebuild --platform android",
    "build:ios": "expo prebuild --platform ios",
    "analyze:bundle": "expo export -p web && source-map-explorer dist/_expo/static/js/web/*.js --html bundle-report.html",
    "analyze:bundle:ci": "expo export -p web && node scripts/check-bundle-size.js",
    "audit": "npm audit",
    "audit:fix": "npm audit fix",
    "deploy:cloudflare": "node scripts/deploy-cloudflare.js",
    "deploy:ops": "node scripts/deploy-cloudflare.js --project-name=ops-uniqn",
    "release:sync": "node scripts/sync-app-version.js",
    "release:sync:dry": "node scripts/sync-app-version.js --dry-run",
    "release:check": "node scripts/check-version-consistency.js",
    "release:build": "npm run release:check && eas build --platform all --profile production --auto-submit --non-interactive",
    "release": "npm version patch -m \"chore(release): v%s\" && npm run release:build && npm run release:sync",
    "e2e": "node scripts/run-e2e.js",
    "e2e:ui": "node scripts/run-e2e.js --ui",
    "e2e:headed": "node scripts/run-e2e.js --headed",
    "e2e:report": "npx playwright show-report",
    "e2e:setup": "npx playwright install --with-deps chromium",
    "eas-build-pre-install": "bash ./scripts/eas-build-pre-install.sh"
  },
  "dependencies": {
    "@expo-google-fonts/outfit": "^0.4.3",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@portone/browser-sdk": "^0.1.3",
    "@portone/react-native-sdk": "^0.6.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.5.2",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.0.2",
    "@supabase/supabase-js": "^2.103.0",
    "@tanstack/react-query": "^5.90.12",
    "base64-js": "^1.5.1",
    "blurhash": "^2.0.5",
    "date-fns": "^4.1.0",
    "expo": "~55.0.28",
    "expo-apple-authentication": "~55.0.15",
    "expo-build-properties": "~55.0.16",
    "expo-camera": "~57.0.3",
    "expo-constants": "~55.0.9",
    "expo-crypto": "~55.0.17",
    "expo-dev-client": "~55.0.37",
    "expo-device": "~55.0.19",
    "expo-font": "~55.0.6",
    "expo-haptics": "~55.0.16",
    "expo-image": "~55.0.11",
    "expo-image-manipulator": "~55.0.19",
    "expo-image-picker": "~55.0.22",
    "expo-intent-launcher": "~55.0.14",
    "expo-linking": "~55.0.16",
    "expo-local-authentication": "~55.0.16",
    "expo-modules-core": "^55.0.22",
    "expo-notifications": "~55.0.25",
    "expo-router": "~55.0.17",
    "expo-screen-orientation": "~55.0.18",
    "expo-secure-store": "~55.0.16",
    "expo-splash-screen": "~55.0.23",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.20",
    "expo-updates": "~55.0.26",
    "jpeg-js": "^0.4.4",
    "jsqr": "^1.4.0",
    "lucide-react-native": "^1.8.0",
    "nativewind": "^4.2.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.68.0",
    "react-native": "0.83.6",
    "react-native-calendars": "^1.1313.0",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-keyboard-controller": "^1.22.2",
    "react-native-mmkv": "4.1.2",
    "react-native-nitro-modules": "0.33.2",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.4",
    "tailwindcss": "^3.4.19",
    "zod": "^4.1.13",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "babel-preset-expo": "~55.0.8",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~55.0.1",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-native": "^5.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.20",
    "jest-watch-typeahead": "^2.2.2",
    "knip": "6.25.0",
    "prettier": "^3.8.1",
    "react-refresh": "^0.14.2",
    "react-test-renderer": "19.2.0",
    "source-map-explorer": "^2.5.3",
    "typescript": "~5.9.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "react-native-safe-area-context": "~5.6.0",
    "react-test-renderer": "19.2.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "expo-modules-core",
        "react-native-keyboard-controller"
      ]
    }
  },
  "knip": {
    "ignore": [
      "babel.config.js",
      "supabase/functions/**",
      "e2e/**",
      "src/__tests__/mocks/**",
      "functions/**",
      "scripts/verify-web-build.js"
    ],
    "ignoreBinaries": [
      "supabase",
      "eas"
    ],
    "ignoreDependencies": [
      "react-native-mmkv",
      "react-native-nitro-modules",
      "expo-intent-launcher",
      "expo-modules-core",
      "babel-preset-expo",
      "react-refresh"
    ]
  },
  "private": true
}
