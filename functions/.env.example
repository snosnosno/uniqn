# Firebase Cloud Functions 환경 변수
# .env 파일로 복사 후 실제 값을 입력하세요
# cp .env.example .env

# reCAPTCHA v3 (전화번호 중복체크 봇 방지, 미설정 시 검증 스킵)
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# Firebase Web API Key (서버사이드 OTP 검증용)
# Firebase 콘솔 → 프로젝트 설정 → 일반 → 웹 API 키
# 주의: FIREBASE_ 접두사는 CF 예약어이므로 WEB_API_KEY 사용
WEB_API_KEY=your_firebase_api_key_here
