# Firebase Cloud Functions environment variables
# Copy to .env and replace the placeholder values:
# cp .env.example .env

# ============================================================================
# Release blockers
# ============================================================================
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here
WEB_API_KEY=your_firebase_api_key_here

# ============================================================================
# Optional feature-specific secrets
# ============================================================================
# APPLE_PRIVATE_KEY=your_apple_private_key_here
# APPLE_KEY_ID=your_apple_key_id_here
# APPLE_TEAM_ID=your_apple_team_id_here
# APPLE_CLIENT_ID=your_apple_client_id_here

# SENTRY_DSN=https://your-dsn@sentry.io/your-project-id

# CF_ACCOUNT_ID=your_cloudflare_account_id_here
# CF_KV_NAMESPACE_ID=your_cloudflare_kv_namespace_id_here
# CF_API_TOKEN=your_cloudflare_api_token_here
