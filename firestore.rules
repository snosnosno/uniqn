rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ================= Helper Functions =================
    function isSignedIn() {
      return request.auth != null;
    }
    
    // ================= Security Functions =================
    // 입력 데이터 검증
    function isValidString(field, maxLength) {
      return field is string && field.size() <= maxLength;
    }
    
    // XSS 패턴 검사
    function hasNoXSS(text) {
      return !text.matches('.*<script.*') &&
             !text.matches('.*javascript\\s*:.*') &&
             !text.matches('.*on\\w+\\s*=.*') &&
             !text.matches('.*<\\s*iframe.*') &&
             !text.matches('.*<\\s*object.*') &&
             !text.matches('.*<\\s*embed.*') &&
             !text.matches('.*<\\s*link\\b.*') &&
             !text.matches('.*data\\s*:\\s*(text|image|application|multipart)/.*') &&
             !text.matches('.*expression\\s*\\(.*');
    }
    
    // SQL Injection 패턴 검사
    function hasNoSQLInjection(text) {
      return !text.matches('.*union.*select.*') &&
             !text.matches('.*select.*from.*') &&
             !text.matches('.*insert.*into.*') &&
             !text.matches('.*delete.*from.*') &&
             !text.matches('.*drop.*table.*');
    }
    
    // 안전한 텍스트 검증
    function isSafeText(text, maxLength) {
      return isValidString(text, maxLength) && 
             hasNoXSS(text) && 
             hasNoSQLInjection(text);
    }

    // ================= Role Helper Functions (Firestore 문서 기반) =================
    // Custom Claims 대신 Firestore users 문서에서 role을 읽어옴
    // 장점: 즉시 반영 (토큰 갱신 불필요)
    // 단점: 각 요청마다 추가 읽기 1회 발생

    // 사용자의 역할 가져오기
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // 관리자 권한 확인 (admin, employer, manager)
    // ⚠️ manager는 하위 호환성을 위해 유지 (employer와 동일 권한)
    function isPrivileged() {
      return getUserRole() in ['admin', 'employer', 'manager'];
    }

    // 유효한 역할 확인 (admin, employer, manager, staff)
    // 역할 계층: admin(100) > employer/manager(50) > staff(10)
    function hasValidRole() {
      return getUserRole() in ['admin', 'employer', 'manager', 'staff'];
    }

    function canManageJobPostings() {
      return getUserRole() in ['admin', 'employer', 'manager'];
    }

    // 관리자 여부 확인
    function isAdmin() {
      return getUserRole() == 'admin';
    }

    function canReadWorkLog(workLogData) {
      return isSignedIn() && (
        isAdmin() ||
        request.auth.uid == workLogData.staffId ||
        (isPrivileged() && request.auth.uid == workLogData.ownerId) ||
        (isPrivileged() &&
         exists(/databases/$(database)/documents/jobPostings/$(workLogData.jobPostingId)) &&
         get(/databases/$(database)/documents/jobPostings/$(workLogData.jobPostingId)).data.ownerId == request.auth.uid)
      );
    }

    function canCreateAuthoritativeTimeModificationLog(workLogData) {
      return isSignedIn() && (
        isAdmin() ||
        (isPrivileged() && request.auth.uid == workLogData.ownerId) ||
        (isPrivileged() &&
         exists(/databases/$(database)/documents/jobPostings/$(workLogData.jobPostingId)) &&
         get(/databases/$(database)/documents/jobPostings/$(workLogData.jobPostingId)).data.ownerId == request.auth.uid)
      );
    }

    function canReadTimeModificationLog(logData) {
      return logData.workLogId is string &&
        exists(/databases/$(database)/documents/workLogs/$(logData.workLogId)) &&
        canReadWorkLog(get(/databases/$(database)/documents/workLogs/$(logData.workLogId)).data);
    }

    function canCreateTimeModificationLog(workLogId) {
      return exists(/databases/$(database)/documents/workLogs/$(workLogId)) &&
        canCreateAuthoritativeTimeModificationLog(
          get(/databases/$(database)/documents/workLogs/$(workLogId)).data
        ) &&
        request.resource.data.workLogId == workLogId &&
        request.resource.data.keys().hasAll([
          'workLogId',
          'modifiedAt',
          'modifiedBy',
          'reason',
          'previousStartTime',
          'previousEndTime',
          'newStartTime',
          'newEndTime'
        ]) &&
        request.resource.data.keys().hasOnly([
          'workLogId',
          'modifiedAt',
          'modifiedBy',
          'reason',
          'previousStartTime',
          'previousEndTime',
          'newStartTime',
          'newEndTime'
        ]) &&
        request.resource.data.modifiedAt == request.time &&
        request.resource.data.modifiedBy == request.auth.uid &&
        request.resource.data.modifiedBy is string &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() > 0 &&
        request.resource.data.reason.size() <= 200 &&
        (request.resource.data.previousStartTime == null || request.resource.data.previousStartTime is timestamp) &&
        (request.resource.data.previousEndTime == null || request.resource.data.previousEndTime is timestamp) &&
        (request.resource.data.newStartTime == null || request.resource.data.newStartTime is timestamp) &&
        (request.resource.data.newEndTime == null || request.resource.data.newEndTime is timestamp);
    }
    

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isManagedBoardType(boardType) {
      return boardType in ['schedule', 'free', 'tda'];
    }

    function isCommunityBoardType(boardType) {
      return boardType in ['free', 'tda'];
    }

    function isBoardVisibility(visibility) {
      return visibility in ['public', 'participants_only'];
    }

    function isBoardVisibleStatus(status) {
      return status in ['active', 'locked'];
    }

    function isBoardPostStatus(status) {
      return status in ['active', 'locked', 'hidden', 'archived'];
    }

    function isBoardCommentStatus(status) {
      return status in ['active', 'hidden', 'deleted'];
    }

    function isBoardVoteType(type) {
      return type in ['like', 'dislike'];
    }

    function isBoardAuthorRole(role) {
      return role in ['admin', 'employer', 'manager', 'staff', 'system'];
    }

    function isBoardMemberRole(role) {
      return role in ['author', 'confirmed', 'admin'];
    }

    function isCommentReactionType(type) {
      return type in ['thumbs_up', 'heart', 'laugh', 'surprised', 'sad', 'angry'];
    }

    function isBoardReportTargetType(targetType) {
      return targetType in ['post', 'comment'];
    }

    function isBoardReportStatus(status) {
      return status in ['pending', 'resolved', 'dismissed'];
    }

    function isValidBoardImageList(images, maxCount) {
      return images is list && images.size() <= maxCount;
    }

    function isBoardNoticePostId(postId) {
      return postId is string && postId.matches('^notice_.+$');
    }

    function isScheduleBoardPostId(postId, jobPostingId) {
      return postId is string &&
        jobPostingId is string &&
        postId == 'schedule_' + jobPostingId;
    }

    function getBoardMembershipDocId(postId, userId) {
      return postId + '_' + userId;
    }

    function boardPostExists(postId) {
      return exists(/databases/$(database)/documents/boardPosts/$(postId));
    }

    function getBoardPostData(postId) {
      return get(/databases/$(database)/documents/boardPosts/$(postId)).data;
    }

    function hasScheduleBoardReadMembership(postId) {
      let membershipId = getBoardMembershipDocId(postId, request.auth.uid);
      return isSignedIn() &&
        exists(/databases/$(database)/documents/boardMemberships/$(membershipId)) &&
        get(/databases/$(database)/documents/boardMemberships/$(membershipId)).data.boardType == 'schedule' &&
        get(/databases/$(database)/documents/boardMemberships/$(membershipId)).data.canRead == true;
    }

    function hasScheduleBoardCommentMembership(postId) {
      let membershipId = getBoardMembershipDocId(postId, request.auth.uid);
      return isSignedIn() &&
        exists(/databases/$(database)/documents/boardMemberships/$(membershipId)) &&
        get(/databases/$(database)/documents/boardMemberships/$(membershipId)).data.boardType == 'schedule' &&
        get(/databases/$(database)/documents/boardMemberships/$(membershipId)).data.canRead == true &&
        get(/databases/$(database)/documents/boardMemberships/$(membershipId)).data.canComment == true;
    }

    function canManageLinkedJobPosting(jobPostingId) {
      return isSignedIn() &&
        jobPostingId is string &&
        exists(/databases/$(database)/documents/jobPostings/$(jobPostingId)) &&
        (
          isAdmin() ||
          get(/databases/$(database)/documents/jobPostings/$(jobPostingId)).data.ownerId == request.auth.uid
        );
    }

    function isBoardPostAuthor(postData) {
      return isSignedIn() && postData.authorId == request.auth.uid;
    }

    function canManageBoardPostData(postData) {
      return isSignedIn() && (isAdmin() || isBoardPostAuthor(postData));
    }

    function canReadBoardPostData(postId, postData) {
      return isSignedIn() && (
        (
          isCommunityBoardType(postData.boardType) &&
          (
            isBoardVisibleStatus(postData.status) ||
            isAdmin() ||
            isBoardPostAuthor(postData)
          )
        ) ||
        (
          postData.boardType == 'schedule' &&
          (
            isAdmin() ||
            isBoardPostAuthor(postData) ||
            (isBoardVisibleStatus(postData.status) && hasScheduleBoardReadMembership(postId))
          )
        )
      );
    }

    function canReadBoardPost(postId) {
      return isSignedIn() &&
        boardPostExists(postId) &&
        canReadBoardPostData(postId, getBoardPostData(postId));
    }

    function canInteractBoardPostData(postId, postData) {
      return canReadBoardPostData(postId, postData) &&
        postData.status == 'active' &&
        postData.isLocked == false &&
        (
          isCommunityBoardType(postData.boardType) ||
          isAdmin() ||
          isBoardPostAuthor(postData) ||
          hasScheduleBoardCommentMembership(postId)
        );
    }

    function canInteractBoardPost(postId) {
      return isSignedIn() &&
        boardPostExists(postId) &&
        canInteractBoardPostData(postId, getBoardPostData(postId));
    }

    function canReadBoardReportTarget(postId, targetType, targetId) {
      return isSignedIn() && (
        (
          targetType == 'post' &&
          canReadBoardPost(postId)
        ) ||
        (
          targetType == 'comment' &&
          boardPostExists(postId) &&
          canReadBoardPost(postId) &&
          exists(/databases/$(database)/documents/boardPosts/$(postId)/comments/$(targetId)) &&
          get(/databases/$(database)/documents/boardPosts/$(postId)/comments/$(targetId)).data.status == 'active'
        )
      );
    }

    function canReadOwnMissingApplication(applicationId) {
      return isSignedIn() &&
        !exists(/databases/$(database)/documents/applications/$(applicationId)) &&
        applicationId.matches('^.+_' + request.auth.uid + '$');
    }

    function isApplicantReapplyUpdate() {
      let changedFields = getApplicationChangedFields();

      return isSignedIn() &&
        request.auth.uid == resource.data.applicantId &&
        resource.data.status == 'cancelled' &&
        request.resource.data.applicantId == resource.data.applicantId &&
        request.resource.data.jobPostingId == resource.data.jobPostingId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.status == 'applied' &&
        request.resource.data.isRead == false &&
        request.resource.data.updatedAt == request.time &&
        changedFields.hasOnly([
          'applicantName',
          'applicantPhone',
          'applicantEmail',
          'applicantRole',
          'applicantNickname',
          'applicantPhotoURL',
          'jobPostingTitle',
          'jobPostingDate',
          'status',
          'customRole',
          'message',
          'recruitmentType',
          'assignments',
          'preQuestionAnswers',
          'originalApplication',
          'confirmationHistory',
          'processedBy',
          'processedAt',
          'rejectionReason',
          'confirmedAt',
          'cancelledAt',
          'notes',
          'cancellationRequest',
          'isRead',
          'updatedAt'
        ]) &&
        request.resource.data.assignments is list &&
        (!('preQuestionAnswers' in request.resource.data) || request.resource.data.preQuestionAnswers is list);
    }

    function getApplicationChangedFields() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isCanonicalApplicationCreate(applicationId) {
      let data = request.resource.data;

      return isSignedIn() &&
        request.auth.uid == data.applicantId &&
        data.keys().hasAll([
          'applicantId',
          'applicantName',
          'jobPostingId',
          'status',
          'recruitmentType',
          'assignments',
          'isRead',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'applicantId',
          'applicantName',
          'applicantPhone',
          'applicantEmail',
          'applicantRole',
          'applicantNickname',
          'applicantPhotoURL',
          'jobPostingId',
          'jobPostingTitle',
          'jobPostingDate',
          'status',
          'customRole',
          'message',
          'recruitmentType',
          'assignments',
          'preQuestionAnswers',
          'isRead',
          'createdAt',
          'updatedAt'
        ]) &&
        data.jobPostingId is string &&
        applicationId == data.jobPostingId + '_' + request.auth.uid &&
        exists(/databases/$(database)/documents/jobPostings/$(data.jobPostingId)) &&
        get(/databases/$(database)/documents/jobPostings/$(data.jobPostingId)).data.status == 'active' &&
        get(/databases/$(database)/documents/jobPostings/$(data.jobPostingId)).data.schedule.kind in ['dated', 'fixed'] &&
        data.applicantName is string &&
        (!('applicantPhone' in data) || data.applicantPhone is string) &&
        (!('applicantEmail' in data) || data.applicantEmail is string) &&
        (!('applicantRole' in data) || data.applicantRole is string) &&
        (!('applicantNickname' in data) || data.applicantNickname is string) &&
        (!('applicantPhotoURL' in data) || data.applicantPhotoURL is string) &&
        (!('jobPostingTitle' in data) || data.jobPostingTitle is string) &&
        (!('jobPostingDate' in data) || data.jobPostingDate is string) &&
        (!('customRole' in data) || data.customRole is string) &&
        (!('message' in data) || data.message is string) &&
        data.status == 'applied' &&
        data.recruitmentType in ['event', 'fixed'] &&
        data.assignments is list &&
        data.assignments.size() > 0 &&
        (!('preQuestionAnswers' in data) || data.preQuestionAnswers is list) &&
        data.isRead == false &&
        data.createdAt == request.time &&
        data.updatedAt == request.time;
    }

    function isApplicantCancellationUpdate() {
      return isSignedIn() &&
        request.auth.uid == resource.data.applicantId &&
        resource.data.status == 'applied' &&
        request.resource.data.status == 'cancelled' &&
        getApplicationChangedFields().hasOnly(['status', 'updatedAt']) &&
        getApplicationChangedFields().hasAll(['status', 'updatedAt']) &&
        request.resource.data.updatedAt == request.time;
    }

    function isApplicantCancellationRequestUpdate() {
      let requestData = request.resource.data.cancellationRequest;

      return isSignedIn() &&
        request.auth.uid == resource.data.applicantId &&
        resource.data.jobPostingId is string &&
        exists(/databases/$(database)/documents/jobPostings/$(resource.data.jobPostingId)) &&
        get(/databases/$(database)/documents/jobPostings/$(resource.data.jobPostingId)).data.schedule.kind == 'dated' &&
        resource.data.status == 'confirmed' &&
        request.resource.data.status == 'cancellation_pending' &&
        getApplicationChangedFields().hasOnly(['status', 'cancellationRequest', 'updatedAt']) &&
        getApplicationChangedFields().hasAll(['status', 'cancellationRequest', 'updatedAt']) &&
        request.resource.data.updatedAt == request.time &&
        requestData is map &&
        requestData.keys().hasAll(['requestedAt', 'reason', 'status']) &&
        requestData.keys().hasOnly(['requestedAt', 'reason', 'status']) &&
        requestData.requestedAt == request.time &&
        requestData.status == 'pending' &&
        requestData.reason is string &&
        requestData.reason.size() >= 5 &&
        requestData.reason.size() <= 500;
    }

    function canApplicantUpdateOwnApplication() {
      let changedFields = getApplicationChangedFields();
      let requestData = request.resource.data.cancellationRequest;

      return request.resource.data.applicantId == resource.data.applicantId &&
        request.resource.data.jobPostingId == resource.data.jobPostingId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        (
          (
            resource.data.status == 'cancelled' &&
            request.resource.data.status == 'applied' &&
            request.resource.data.keys().hasAll([
              'applicantId',
              'applicantName',
              'jobPostingId',
              'status',
              'recruitmentType',
              'assignments',
              'isRead',
              'createdAt',
              'updatedAt'
            ]) &&
            request.resource.data.recruitmentType in ['event', 'fixed'] &&
            request.resource.data.assignments is list &&
            request.resource.data.assignments.size() > 0 &&
            (!('preQuestionAnswers' in request.resource.data) ||
              request.resource.data.preQuestionAnswers is list) &&
            request.resource.data.isRead == false &&
            request.resource.data.updatedAt == request.time
          ) ||
          (
            resource.data.status == 'applied' &&
            request.resource.data.status == 'cancelled' &&
            changedFields.hasOnly(['status', 'updatedAt']) &&
            changedFields.hasAll(['status', 'updatedAt']) &&
            request.resource.data.updatedAt == request.time
          ) ||
          (
            resource.data.status == 'confirmed' &&
            resource.data.jobPostingId is string &&
            exists(/databases/$(database)/documents/jobPostings/$(resource.data.jobPostingId)) &&
            get(/databases/$(database)/documents/jobPostings/$(resource.data.jobPostingId)).data.schedule.kind == 'dated' &&
            request.resource.data.status == 'cancellation_pending' &&
            changedFields.hasOnly(['status', 'cancellationRequest', 'updatedAt']) &&
            changedFields.hasAll(['status', 'cancellationRequest', 'updatedAt']) &&
            request.resource.data.updatedAt == request.time &&
            requestData is map &&
            requestData.keys().hasAll(['requestedAt', 'reason', 'status']) &&
            requestData.keys().hasOnly(['requestedAt', 'reason', 'status']) &&
            requestData.requestedAt == request.time &&
            requestData.status == 'pending' &&
            requestData.reason is string &&
            requestData.reason.size() >= 5 &&
            requestData.reason.size() <= 500
          )
        );
    }

    function applicationPostingOwnerMatches(jobPostingId) {
      return jobPostingId is string &&
        exists(/databases/$(database)/documents/jobPostings/$(jobPostingId)) &&
        get(/databases/$(database)/documents/jobPostings/$(jobPostingId)).data.ownerId ==
          request.auth.uid;
    }

    function isApplicationPostingOwner() {
      return hasValidRole() && applicationPostingOwnerMatches(resource.data.jobPostingId);
    }

    function isApprovedCancellationRequestPayload(requestData) {
      return requestData is map &&
        requestData.keys().hasOnly([
          'requestedAt',
          'reason',
          'reviewedAt',
          'reviewedBy',
          'status'
        ]) &&
        resource.data.cancellationRequest is map &&
        requestData.requestedAt == resource.data.cancellationRequest.requestedAt &&
        requestData.reason == resource.data.cancellationRequest.reason &&
        requestData.reviewedAt == request.time &&
        requestData.reviewedBy == request.auth.uid &&
        requestData.status == 'approved';
    }

    function isRejectedCancellationRequestPayload(requestData) {
      return requestData is map &&
        requestData.keys().hasOnly([
          'requestedAt',
          'reason',
          'reviewedAt',
          'reviewedBy',
          'status',
          'rejectionReason'
        ]) &&
        resource.data.cancellationRequest is map &&
        requestData.requestedAt == resource.data.cancellationRequest.requestedAt &&
        requestData.reason == resource.data.cancellationRequest.reason &&
        requestData.reviewedAt == request.time &&
        requestData.reviewedBy == request.auth.uid &&
        requestData.status == 'rejected' &&
        requestData.rejectionReason is string &&
        requestData.rejectionReason.size() >= 3 &&
        requestData.rejectionReason.size() <= 500;
    }

    function canOwnerUpdateApplicationLifecycle() {
      let changedFields = getApplicationChangedFields();
      let requestData = request.resource.data.cancellationRequest;
      let sameIdentity =
        request.resource.data.applicantId == resource.data.applicantId &&
        request.resource.data.jobPostingId == resource.data.jobPostingId &&
        request.resource.data.createdAt == resource.data.createdAt;

      return sameIdentity &&
        isApplicationPostingOwner() &&
        (
          (
            resource.data.status == 'applied' &&
            request.resource.data.status == 'confirmed' &&
            changedFields.hasOnly([
              'status',
              'assignments',
              'originalApplication',
              'confirmationHistory',
              'confirmedAt',
              'processedBy',
              'processedAt',
              'notes',
              'updatedAt'
            ]) &&
            changedFields.hasAll([
              'originalApplication',
              'confirmationHistory',
              'confirmedAt',
              'processedBy',
              'processedAt',
              'updatedAt'
            ]) &&
            request.resource.data.assignments is list &&
            request.resource.data.confirmationHistory is list &&
            'originalApplication' in request.resource.data &&
            request.resource.data.processedBy == request.auth.uid
          ) ||
          (
            resource.data.status == 'applied' &&
            request.resource.data.status == 'rejected' &&
            changedFields.hasOnly([
              'status',
              'rejectionReason',
              'processedBy',
              'processedAt',
              'updatedAt'
            ]) &&
            changedFields.hasAll(['processedBy', 'processedAt', 'updatedAt']) &&
            request.resource.data.processedBy == request.auth.uid &&
            (!('rejectionReason' in request.resource.data) ||
              request.resource.data.rejectionReason is string)
          ) ||
          (
            resource.data.status == 'confirmed' &&
            resource.data.jobPostingId is string &&
            exists(/databases/$(database)/documents/jobPostings/$(resource.data.jobPostingId)) &&
            get(/databases/$(database)/documents/jobPostings/$(resource.data.jobPostingId)).data.schedule.kind == 'dated' &&
            request.resource.data.status == 'applied' &&
            changedFields.hasOnly([
              'status',
              'assignments',
              'confirmationHistory',
              'cancelledAt',
              'updatedAt'
            ]) &&
            changedFields.hasAll(['cancelledAt', 'updatedAt']) &&
            request.resource.data.assignments is list &&
            request.resource.data.confirmationHistory is list
          ) ||
          (
            resource.data.status == 'cancellation_pending' &&
            resource.data.jobPostingId is string &&
            exists(/databases/$(database)/documents/jobPostings/$(resource.data.jobPostingId)) &&
            get(/databases/$(database)/documents/jobPostings/$(resource.data.jobPostingId)).data.schedule.kind == 'dated' &&
            resource.data.cancellationRequest is map &&
            resource.data.cancellationRequest.status == 'pending' &&
            request.resource.data.status == 'cancelled' &&
            changedFields.hasOnly([
              'status',
              'assignments',
              'confirmationHistory',
              'cancelledAt',
              'cancellationRequest',
              'updatedAt'
            ]) &&
            request.resource.data.updatedAt == request.time &&
            request.resource.data.assignments is list &&
            request.resource.data.confirmationHistory is list &&
            isApprovedCancellationRequestPayload(requestData)
          ) ||
          (
            resource.data.status == 'cancellation_pending' &&
            resource.data.jobPostingId is string &&
            exists(/databases/$(database)/documents/jobPostings/$(resource.data.jobPostingId)) &&
            get(/databases/$(database)/documents/jobPostings/$(resource.data.jobPostingId)).data.schedule.kind == 'dated' &&
            resource.data.cancellationRequest is map &&
            resource.data.cancellationRequest.status == 'pending' &&
            request.resource.data.status == 'confirmed' &&
            changedFields.hasOnly(['status', 'cancellationRequest', 'updatedAt']) &&
            request.resource.data.updatedAt == request.time &&
            isRejectedCancellationRequestPayload(requestData)
          ) ||
          (
            changedFields.hasOnly(['isRead', 'updatedAt']) &&
            changedFields.hasAll(['isRead', 'updatedAt']) &&
            request.resource.data.isRead == true
          )
        );
    }

    // ================= Employer Registration Validation =================
    // 구인자 등록 시 역할 변경 검증
    // - staff → employer 변경만 허용
    // - 본인인증 완료 필수
    // - 필수 필드 검증
    function isValidEmployerRegistration() {
      let currentData = resource.data;
      let newData = request.resource.data;
      let changedFields = newData.diff(currentData).affectedKeys();

      // 1. 변경 가능한 필드만 변경되었는지 확인
      let allowedFields = ['role', 'employerAgreements', 'employerRegisteredAt', 'updatedAt'];

      return changedFields.hasOnly(allowedFields) &&
        // 2. 현재 역할이 staff인지 확인
        currentData.role == 'staff' &&
        // 3. 새 역할이 employer인지 확인
        newData.role == 'employer' &&
        // 4. 전화번호 인증 완료 여부 확인
        currentData.phoneVerified == true &&
        // 5. employerAgreements 필수 필드 확인
        'employerAgreements' in newData &&
        newData.employerAgreements.keys().hasAll([
          'termsAgreedAt',
          'termsVersion',
          'liabilityWaiverAgreedAt',
          'liabilityWaiverVersion'
        ]) &&
        newData.employerAgreements.termsVersion is string &&
        newData.employerAgreements.liabilityWaiverVersion is string &&
        // 6. employerRegisteredAt 존재 확인
        'employerRegisteredAt' in newData &&
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)/consents/employer_registration) &&
        existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/consents/employer_registration) &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/consents/employer_registration).data.kind == 'employer_registration' &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/consents/employer_registration).data.userId == request.auth.uid &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/consents/employer_registration).data.terms.agreed == true &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/consents/employer_registration).data.terms.version ==
          newData.employerAgreements.termsVersion &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/consents/employer_registration).data.liabilityWaiver.agreed == true &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/consents/employer_registration).data.liabilityWaiver.version ==
          newData.employerAgreements.liabilityWaiverVersion &&
        newData.updatedAt == request.time &&
        newData.employerRegisteredAt == request.time &&
        newData.employerAgreements.termsAgreedAt == request.time &&
        newData.employerAgreements.liabilityWaiverAgreedAt == request.time;
    }

    function isValidSelfUserUpdate() {
      let currentData = resource.data;
      let newData = request.resource.data;
      let changedFields = newData.diff(currentData).affectedKeys();
      let allowedFields = [
        'nickname',
        'photoURL',
        'region',
        'experienceYears',
        'career',
        'note',
        'marketingAgreed',
        'profileCompleted',
        'updatedAt'
      ];

      return changedFields.hasOnly(allowedFields) &&
        changedFields.hasAny(['updatedAt']) &&
        newData.updatedAt == request.time &&
        (!('nickname' in newData) || (newData.nickname is string &&
          newData.nickname.size() >= 2 &&
          newData.nickname.size() <= 15)) &&
        (!('photoURL' in newData) || newData.photoURL == null || newData.photoURL is string) &&
        (!('region' in newData) || isSafeText(newData.region, 50)) &&
        (!('experienceYears' in newData) || (newData.experienceYears is number &&
          newData.experienceYears >= 0 &&
          newData.experienceYears <= 50)) &&
        (!('career' in newData) || (newData.career is string &&
          newData.career.size() <= 500)) &&
        (!('note' in newData) || (newData.note is string &&
          newData.note.size() <= 300)) &&
        (!('marketingAgreed' in newData) || newData.marketingAgreed is bool) &&
        (!changedFields.hasAny(['profileCompleted']) ||
          newData.profileCompleted == true);
    }

    function isValidFcmTokenSelfUpdate() {
      let newData = request.resource.data;
      let changedFields = newData.diff(resource.data).affectedKeys();

      return changedFields.hasAny(['fcmTokens']) &&
        changedFields.hasOnly(['fcmTokens', 'updatedAt']) &&
        (!changedFields.hasAny(['updatedAt']) || newData.updatedAt == request.time) &&
        (!('fcmTokens' in newData) || (
          newData.fcmTokens is map &&
          newData.fcmTokens.keys().size() <= 10
        ));
    }

    // ================= Job Posting Type Validation Functions =================
    // ⚠️ 클라이언트 Timestamp는 Security Rules의 `is timestamp` 검증을 통과하지 못함
    // 따라서 timestamp 필드는 존재 여부만 확인 (타입 검증 제거)

    // FixedConfig 검증 함수
    function validateFixedConfig(config) {
      return config.durationDays == 7;
    }

    // TournamentConfig 검증 함수
    function validateTournamentConfig(config) {
      return config.approvalStatus in ['pending', 'approved', 'rejected'] &&
             'submittedAt' in config &&
             (!('approvedBy' in config) || config.approvedBy is string) &&
             (!('rejectedBy' in config) || config.rejectedBy is string) &&
             (!('rejectionReason' in config) || (config.rejectionReason is string && config.rejectionReason.size() >= 10));
    }

    // UrgentConfig 검증 함수
    function validateUrgentConfig(config) {
      return config.priority == 'high' &&
             'createdAt' in config;
    }

    // Tournament 승인 필드만 변경되었는지 확인 (admin 전용)
    function hasCanonicalJobPostingKeys(data) {
      return data.keys().hasAll([
               'schemaVersion',
               'title',
               'status',
               'ownerId',
               'location',
               'workDate',
               'totalPositions',
               'filledPositions',
               'createdAt',
               'updatedAt',
               'schedule',
               'roleCatalog',
               'compensation',
               'questions'
             ]) &&
             data.keys().hasOnly([
               'schemaVersion',
               'title',
               'description',
               'status',
               'ownerId',
               'ownerName',
               'postingType',
               'workDate',
               'workDates',
               'roleKeys',
               'totalPositions',
               'filledPositions',
               'viewCount',
               'stats',
               'createdAt',
               'updatedAt',
               'searchIndex',
               'closedAt',
               'closedReason',
               'tags',
               'contactPhone',
               'location',
               'schedule',
               'roleCatalog',
               'compensation',
               'questions',
               'fixedConfig',
               'tournamentConfig',
               'urgentConfig'
             ]);
    }

    function validateCanonicalLocation(location) {
      return location is map &&
             location.keys().hasAll(['name']) &&
             location.keys().hasOnly(['name', 'district', 'detailedAddress']) &&
             location.name is string &&
             (!('district' in location) || location.district is string) &&
             (!('detailedAddress' in location) || location.detailedAddress is string);
    }

    function validateSalaryInfoMap(salary) {
      return salary is map &&
             salary.keys().hasAll(['type', 'amount']) &&
             salary.keys().hasOnly(['type', 'amount']) &&
             salary.type in ['hourly', 'daily', 'monthly', 'other'] &&
             salary.amount is number;
    }

    function validateAllowancesMap(allowances) {
      return allowances is map &&
             allowances.keys().hasOnly([
               'guaranteedHours',
               'meal',
               'transportation',
               'accommodation'
             ]) &&
             (!('guaranteedHours' in allowances) || allowances.guaranteedHours is number) &&
             (!('meal' in allowances) || allowances.meal is number) &&
             (!('transportation' in allowances) || allowances.transportation is number) &&
             (!('accommodation' in allowances) || allowances.accommodation is number);
    }

    function validateTaxableItemsMap(items) {
      return items is map &&
             items.keys().hasOnly([
               'basePay',
               'meal',
               'transportation',
               'accommodation',
               'additional'
             ]) &&
             (!('basePay' in items) || items.basePay is bool) &&
             (!('meal' in items) || items.meal is bool) &&
             (!('transportation' in items) || items.transportation is bool) &&
             (!('accommodation' in items) || items.accommodation is bool) &&
             (!('additional' in items) || items.additional is bool);
    }

    function validateTaxSettingsMap(settings) {
      return settings is map &&
             settings.keys().hasAll(['type', 'value']) &&
             settings.keys().hasOnly(['type', 'value', 'taxableItems']) &&
             settings.type in ['none', 'rate', 'fixed'] &&
             settings.value is number &&
             (!('taxableItems' in settings) || validateTaxableItemsMap(settings.taxableItems));
    }

    function validateCanonicalCompensation(compensation) {
      return compensation is map &&
             compensation.keys().hasAll(['mode']) &&
             compensation.keys().hasOnly(['mode', 'defaultSalary', 'allowances', 'taxSettings']) &&
             compensation.mode in ['shared', 'by_role'] &&
             (!('defaultSalary' in compensation) ||
               validateSalaryInfoMap(compensation.defaultSalary)) &&
             (!('allowances' in compensation) ||
               validateAllowancesMap(compensation.allowances)) &&
             (!('taxSettings' in compensation) ||
               validateTaxSettingsMap(compensation.taxSettings));
    }

    function validateCanonicalQuestions(questions) {
      return questions is map &&
             questions.keys().hasAll(['items']) &&
             questions.keys().hasOnly(['items']) &&
             questions.items is list;
    }

    function validateCanonicalPostingStats(stats) {
      return stats is map &&
             stats.keys().hasAll([
               'totalApplicants',
               'activeApplicants',
               'confirmedApplicants',
               'cancellationPendingApplicants',
               'filledPositions'
             ]) &&
             stats.keys().hasOnly([
               'totalApplicants',
               'activeApplicants',
               'confirmedApplicants',
               'cancellationPendingApplicants',
               'filledPositions'
             ]) &&
             stats.totalApplicants is number &&
             stats.activeApplicants is number &&
             stats.confirmedApplicants is number &&
             stats.cancellationPendingApplicants is number &&
             stats.filledPositions is number;
    }

    function isValidCanonicalPostingRole(role) {
      return role in ['dealer', 'floor', 'serving', 'manager', 'staff', 'other'];
    }

    function validateCanonicalFixedSchedule(schedule) {
      return schedule is map &&
        schedule.kind == 'fixed' &&
        schedule.keys().hasOnly([
          'kind',
          'daysPerWeek',
          'startTime',
          'isStartTimeNegotiable',
          'roleRequirements'
        ]) &&
        (!('daysPerWeek' in schedule) ||
          (schedule.daysPerWeek is number &&
            schedule.daysPerWeek >= 0 &&
            schedule.daysPerWeek <= 7)) &&
        (!('startTime' in schedule) || schedule.startTime is string) &&
        (!('isStartTimeNegotiable' in schedule) || schedule.isStartTimeNegotiable is bool) &&
        ('roleRequirements' in schedule) &&
        schedule.roleRequirements is list &&
        schedule.roleRequirements.size() > 0 &&
        schedule.roleRequirements[0] is map &&
        schedule.roleRequirements[0].keys().hasAll(['count']) &&
        schedule.roleRequirements[0].keys().hasOnly(['role', 'customRole', 'count', 'filled']) &&
        schedule.roleRequirements[0].count is number &&
        schedule.roleRequirements[0].count > 0 &&
        (!('role' in schedule.roleRequirements[0]) ||
          isValidCanonicalPostingRole(schedule.roleRequirements[0].role)) &&
        (!('customRole' in schedule.roleRequirements[0]) ||
          schedule.roleRequirements[0].customRole is string) &&
        (!('filled' in schedule.roleRequirements[0]) ||
          (schedule.roleRequirements[0].filled is number &&
            schedule.roleRequirements[0].filled >= 0 &&
            schedule.roleRequirements[0].filled <= schedule.roleRequirements[0].count));
    }

    function validateCanonicalSchedule(schedule) {
      return (
        schedule is map &&
        schedule.kind == 'dated' &&
        schedule.keys().hasAll(['kind', 'primaryDate', 'allDates', 'requirements']) &&
        schedule.keys().hasOnly(['kind', 'primaryDate', 'allDates', 'requirements']) &&
        schedule.primaryDate is string &&
        schedule.allDates is list &&
        schedule.allDates.size() > 0 &&
        schedule.allDates.size() <= 30 &&
        schedule.allDates[0] is string &&
        schedule.requirements is list &&
        schedule.requirements.size() > 0 &&
        schedule.requirements.size() <= 30 &&
        schedule.allDates.size() == schedule.requirements.size() &&
        schedule.requirements[0] is map &&
        schedule.requirements[0].keys().hasAll(['date', 'timeSlots']) &&
        schedule.requirements[0].date is string &&
        schedule.requirements[0].date == schedule.allDates[0] &&
        schedule.requirements[0].timeSlots is list &&
        schedule.requirements[0].timeSlots.size() > 0 &&
        schedule.requirements[0].timeSlots[0] is map &&
        schedule.requirements[0].timeSlots[0].keys().hasAll(['roles']) &&
        schedule.requirements[0].timeSlots[0].roles is list &&
        schedule.requirements[0].timeSlots[0].roles.size() > 0 &&
        schedule.requirements[0].timeSlots[0].roles[0] is map &&
        schedule.requirements[0].timeSlots[0].roles[0].keys().hasAll(['count']) &&
        schedule.requirements[0].timeSlots[0].roles[0].count is number &&
        schedule.requirements[0].timeSlots[0].roles[0].count > 0 &&
        (!('role' in schedule.requirements[0].timeSlots[0].roles[0]) ||
          isValidCanonicalPostingRole(schedule.requirements[0].timeSlots[0].roles[0].role)) &&
        (!('filled' in schedule.requirements[0].timeSlots[0].roles[0]) ||
          (schedule.requirements[0].timeSlots[0].roles[0].filled is number &&
            schedule.requirements[0].timeSlots[0].roles[0].filled >= 0 &&
            schedule.requirements[0].timeSlots[0].roles[0].filled <=
              schedule.requirements[0].timeSlots[0].roles[0].count))
      ) || validateCanonicalFixedSchedule(schedule);
    }

    function getCanonicalPostingType(data) {
      return ('postingType' in data) ? data.postingType : 'regular';
    }

    function validateCanonicalPostingTypeSchedule(data) {
      let postingType = getCanonicalPostingType(data);
      return (
        postingType == 'fixed' && data.schedule.kind == 'fixed'
      ) || (
        postingType != 'fixed' && data.schedule.kind == 'dated'
      );
    }

    function validateCanonicalDerivedScheduleFields(data) {
      return (
        data.schedule.kind == 'dated' &&
        data.workDate == data.schedule.primaryDate &&
        (
          (data.schedule.allDates.size() == 0 && !('workDates' in data)) ||
          (data.schedule.allDates.size() > 0 &&
           'workDates' in data &&
           data.workDates == data.schedule.allDates)
        )
      ) || (
        data.schedule.kind == 'fixed' &&
        data.workDate == '' &&
        !('workDates' in data)
      );
    }

    function validateCanonicalPostingTypeConfigs(data) {
      let postingType = getCanonicalPostingType(data);
      return (
        postingType == 'fixed' &&
        !('tournamentConfig' in data) &&
        !('urgentConfig' in data) &&
        (!('fixedConfig' in data) || validateFixedConfig(data.fixedConfig))
      ) || (
        postingType == 'tournament' &&
        !('fixedConfig' in data) &&
        'tournamentConfig' in data &&
        validateTournamentConfig(data.tournamentConfig) &&
        !('urgentConfig' in data)
      ) || (
        postingType == 'urgent' &&
        !('fixedConfig' in data) &&
        !('tournamentConfig' in data) &&
        'urgentConfig' in data &&
        validateUrgentConfig(data.urgentConfig)
      ) || (
        postingType == 'regular' &&
        !('fixedConfig' in data) &&
        !('tournamentConfig' in data) &&
        !('urgentConfig' in data)
      );
    }

    function validateCanonicalJobPosting(data) {
      return hasCanonicalJobPostingKeys(data) &&
             data.schemaVersion == 3 &&
             isValidString(data.title, 200) &&
             (!('description' in data) || data.description is string) &&
             data.ownerId is string &&
             (!('ownerName' in data) || data.ownerName is string) &&
             validateCanonicalLocation(data.location) &&
             data.workDate is string &&
             (!('workDates' in data) || data.workDates is list) &&
             validateCanonicalPostingTypeSchedule(data) &&
             validateCanonicalDerivedScheduleFields(data) &&
             (!('roleKeys' in data) || data.roleKeys is list) &&
             data.totalPositions is number &&
             data.filledPositions is number &&
             (!('viewCount' in data) || data.viewCount is number) &&
             (!('stats' in data) || validateCanonicalPostingStats(data.stats)) &&
             (!('searchIndex' in data) || data.searchIndex is list) &&
             (!('closedReason' in data) || data.closedReason in ['manual', 'expired', 'expired_by_work_date']) &&
             (!('tags' in data) || data.tags is list) &&
             (!('contactPhone' in data) || isValidString(data.contactPhone, 25)) &&
             validateCanonicalSchedule(data.schedule) &&
             data.roleCatalog is list &&
             data.roleCatalog.size() > 0 &&
             validateCanonicalCompensation(data.compensation) &&
             validateCanonicalQuestions(data.questions) &&
             data.status in ['active', 'closed', 'cancelled'] &&
             (!('postingType' in data) || data.postingType in ['regular', 'fixed', 'tournament', 'urgent']) &&
             validateCanonicalPostingTypeConfigs(data);
    }

    function validateCanonicalJobPostingCreate(data) {
      return hasCanonicalJobPostingKeys(data) &&
             data.schemaVersion == 3 &&
             isValidString(data.title, 200) &&
             (!('description' in data) || data.description is string) &&
             data.ownerId is string &&
             (!('ownerName' in data) || data.ownerName is string) &&
             validateCanonicalLocation(data.location) &&
             data.workDate is string &&
             (!('workDates' in data) || data.workDates is list) &&
             validateCanonicalPostingTypeSchedule(data) &&
             validateCanonicalDerivedScheduleFields(data) &&
             validateCanonicalSchedule(data.schedule) &&
             data.roleCatalog is list &&
             data.roleCatalog.size() > 0 &&
             data.compensation is map &&
             data.questions is map &&
             data.status == 'active' &&
             (!('postingType' in data) || data.postingType in ['regular', 'fixed', 'tournament', 'urgent']) &&
             validateCanonicalPostingTypeConfigs(data) &&
             data.totalPositions is number &&
             !('searchIndex' in data) &&
             !('closedAt' in data) &&
             !('closedReason' in data) &&
             data.filledPositions == 0 &&
             (!('viewCount' in data) || data.viewCount == 0) &&
             (!('stats' in data) || (
               data.stats.totalApplicants == 0 &&
               data.stats.activeApplicants == 0 &&
               data.stats.confirmedApplicants == 0 &&
               data.stats.cancellationPendingApplicants == 0 &&
               data.stats.filledPositions == 0
             ));
    }

    function getCanonicalViewCount(data) {
      return ('viewCount' in data) ? data.viewCount : 0;
    }

    function hasCanonicalJobPostingImmutableFields(nextData, currentData) {
      return nextData.schemaVersion == currentData.schemaVersion &&
             nextData.ownerId == currentData.ownerId &&
             nextData.createdAt == currentData.createdAt &&
             (!('searchIndex' in nextData) ||
               nextData.searchIndex == currentData.searchIndex) &&
             getCanonicalViewCount(nextData) == getCanonicalViewCount(currentData);
    }

    function hasCanonicalJobPostingValidCounters(data) {
      return data.filledPositions >= 0 &&
             data.filledPositions <= data.totalPositions &&
             getCanonicalViewCount(data) >= 0 &&
             (!('stats' in data) || (
               data.stats.totalApplicants >= 0 &&
               data.stats.activeApplicants >= 0 &&
               data.stats.confirmedApplicants >= 0 &&
               data.stats.cancellationPendingApplicants >= 0 &&
               data.stats.filledPositions == data.filledPositions
             ));
    }

    function isFilledPositionsOnlyUpdate(changedFields) {
      return changedFields.hasOnly(['filledPositions', 'stats', 'updatedAt']) &&
             changedFields.hasAll(['filledPositions', 'stats', 'updatedAt']);
    }

    function isStatsOnlyUpdate(changedFields) {
      return changedFields.hasOnly(['stats', 'updatedAt']) &&
             changedFields.hasAll(['stats', 'updatedAt']);
    }

    function isScheduleOccupancyUpdate(changedFields) {
      return changedFields.hasOnly([
               'filledPositions',
               'schedule',
               'stats',
               'status',
               'updatedAt',
               'closedAt',
               'closedReason'
             ]) &&
             changedFields.hasAll(['filledPositions', 'schedule', 'stats', 'updatedAt']);
    }

    function isCanonicalBodyUpdate(changedFields) {
      return !changedFields.hasAny(['filledPositions', 'stats', 'schedule', 'viewCount']);
    }

    function isCanonicalOccupancyUpdate(changedFields) {
      return changedFields.hasAny(['filledPositions', 'stats', 'schedule']);
    }

    function hasSameCanonicalPostingStats(nextData, currentData) {
      return (
        (!('stats' in nextData) && !('stats' in currentData)) ||
        (
          'stats' in nextData &&
          'stats' in currentData &&
          nextData.stats.totalApplicants == currentData.stats.totalApplicants &&
          nextData.stats.activeApplicants == currentData.stats.activeApplicants &&
          nextData.stats.confirmedApplicants == currentData.stats.confirmedApplicants &&
          nextData.stats.cancellationPendingApplicants ==
            currentData.stats.cancellationPendingApplicants &&
          nextData.stats.filledPositions == currentData.stats.filledPositions
        )
      );
    }

    function hasCanonicalJobPostingStableCounters(nextData, currentData) {
      return nextData.filledPositions == currentData.filledPositions &&
             hasSameCanonicalPostingStats(nextData, currentData);
    }

    function validateCanonicalJobPostingUpdate(nextData, currentData) {
      return hasCanonicalJobPostingKeys(nextData) &&
             nextData.schemaVersion == currentData.schemaVersion &&
             nextData.ownerId == currentData.ownerId &&
             nextData.createdAt == currentData.createdAt &&
             validateCanonicalPostingTypeSchedule(nextData) &&
             validateCanonicalDerivedScheduleFields(nextData) &&
             validateCanonicalPostingTypeConfigs(nextData) &&
             validateCanonicalSchedule(nextData.schedule) &&
             nextData.totalPositions is number &&
             nextData.filledPositions is number &&
             nextData.filledPositions >= 0 &&
             nextData.filledPositions <= nextData.totalPositions &&
             nextData.status in ['active', 'closed', 'cancelled'] &&
             hasSameCanonicalPostingStats(nextData, currentData) &&
             (!('searchIndex' in nextData) ||
               nextData.searchIndex == currentData.searchIndex);
    }

    function validateCanonicalJobPostingOccupancyUpdate(nextData, currentData, changedFields) {
      return hasCanonicalJobPostingImmutableFields(nextData, currentData) &&
             hasCanonicalJobPostingValidCounters(nextData) &&
             nextData.totalPositions == currentData.totalPositions &&
             nextData.status in ['active', 'closed', 'cancelled'] &&
             (!changedFields.hasAny(['schedule']) ||
                (validateCanonicalSchedule(nextData.schedule) &&
                 nextData.schedule.primaryDate == currentData.schedule.primaryDate &&
                 nextData.schedule.allDates == currentData.schedule.allDates)) &&
             (
               isStatsOnlyUpdate(changedFields) ||
               isFilledPositionsOnlyUpdate(changedFields) ||
               isScheduleOccupancyUpdate(changedFields)
             );
    }

    function isValidGenericConsentDocument(userId) {
      return request.resource.data.keys().hasAll([
          'version',
          'userId',
          'termsOfService',
          'privacyPolicy'
        ]) &&
        request.resource.data.userId == userId &&
        request.resource.data.termsOfService.agreed == true &&
        request.resource.data.privacyPolicy.agreed == true;
    }

    function isValidEmployerRegistrationConsent(userId) {
      return request.resource.data.keys().hasAll([
          'kind',
          'userId',
          'agreedAt',
          'terms',
          'liabilityWaiver'
        ]) &&
        request.resource.data.keys().hasOnly([
          'kind',
          'userId',
          'agreedAt',
          'terms',
          'liabilityWaiver'
        ]) &&
        request.resource.data.kind == 'employer_registration' &&
        request.resource.data.userId == userId &&
        request.resource.data.terms.agreed == true &&
        request.resource.data.terms.version is string &&
        'agreedAt' in request.resource.data.terms &&
        request.resource.data.liabilityWaiver.agreed == true &&
        request.resource.data.liabilityWaiver.version is string &&
        'agreedAt' in request.resource.data.liabilityWaiver;
    }

    function isDatedWorkLogCreate(data) {
      return data.keys().hasAll(['staffId', 'jobPostingId', 'date', 'status']) &&
             data.staffId is string &&
             data.jobPostingId is string &&
             data.date is string &&
             data.status == 'scheduled' &&
             (!('payrollStatus' in data) || data.payrollStatus == 'pending');
    }

    function doesWorkLogMatchJobPosting(postId, data) {
      return data.jobPostingId is string &&
        data.jobPostingId == postId &&
        data.ownerId is string &&
        exists(/databases/$(database)/documents/jobPostings/$(postId)) &&
        get(/databases/$(database)/documents/jobPostings/$(postId)).data.ownerId == data.ownerId;
    }

    function canManageWorkLogAuthoritatively() {
      return isSignedIn() && (
        isAdmin() ||
        (isPrivileged() && (
          request.auth.uid == resource.data.ownerId ||
          (exists(/databases/$(database)/documents/jobPostings/$(resource.data.jobPostingId)) &&
           get(/databases/$(database)/documents/jobPostings/$(resource.data.jobPostingId)).data.ownerId == request.auth.uid)
        ))
      );
    }

    function isValidWorkLogStatus(status) {
      return status in ['scheduled', 'checked_in', 'checked_out', 'completed', 'cancelled', 'no_show'];
    }

    function isValidPayrollStatus(status) {
      return status in ['pending', 'processing', 'completed'];
    }

    function isValidWorkLogRole(role) {
      return role in ['dealer', 'floor', 'serving', 'manager', 'staff', 'other'];
    }

    function isAuthoritativeWorkLogTimeUpdate() {
      let changedFields = request.resource.data.diff(resource.data).affectedKeys();

      return changedFields.hasOnly([
          'status',
          'checkInTime',
          'checkOutTime',
          'workDuration',
          'notes',
          'settlementBreakdown',
          'hasTimeModificationLogs',
          'updatedAt'
        ]) &&
        changedFields.hasAny([
          'status',
          'checkInTime',
          'checkOutTime',
          'workDuration',
          'notes',
          'settlementBreakdown',
          'hasTimeModificationLogs'
        ]) &&
        changedFields.hasAll(['updatedAt']) &&
        request.resource.data.updatedAt == request.time &&
        (!changedFields.hasAny(['status']) || isValidWorkLogStatus(request.resource.data.status)) &&
        (!changedFields.hasAny(['checkInTime']) ||
         request.resource.data.checkInTime == null ||
         request.resource.data.checkInTime is timestamp) &&
        (!changedFields.hasAny(['checkOutTime']) ||
         request.resource.data.checkOutTime == null ||
         request.resource.data.checkOutTime is timestamp) &&
        (!changedFields.hasAny(['workDuration']) ||
         request.resource.data.workDuration == null ||
         (request.resource.data.workDuration is number &&
          request.resource.data.workDuration >= 0)) &&
        (!changedFields.hasAny(['notes']) ||
         request.resource.data.notes == null ||
         (request.resource.data.notes is string &&
          request.resource.data.notes.size() <= 500)) &&
        (!changedFields.hasAny(['settlementBreakdown']) ||
         request.resource.data.settlementBreakdown == null) &&
        (!changedFields.hasAny(['hasTimeModificationLogs']) ||
         request.resource.data.hasTimeModificationLogs is bool);
    }

    function isAuthoritativeWorkLogSettlementUpdate() {
      let changedFields = request.resource.data.diff(resource.data).affectedKeys();

      return changedFields.hasOnly([
          'payrollStatus',
          'payrollAmount',
          'payrollDate',
          'payrollNotes',
          'updatedAt'
        ]) &&
        changedFields.hasAny(['payrollStatus', 'payrollAmount', 'payrollDate', 'payrollNotes']) &&
        changedFields.hasAll(['updatedAt']) &&
        request.resource.data.updatedAt == request.time &&
        (!changedFields.hasAny(['payrollStatus']) ||
         isValidPayrollStatus(request.resource.data.payrollStatus)) &&
        (!changedFields.hasAny(['payrollAmount']) ||
         request.resource.data.payrollAmount == null ||
         (request.resource.data.payrollAmount is number &&
          request.resource.data.payrollAmount >= 0)) &&
        (!changedFields.hasAny(['payrollDate']) ||
         request.resource.data.payrollDate == null ||
         request.resource.data.payrollDate is timestamp) &&
        (!changedFields.hasAny(['payrollNotes']) ||
         request.resource.data.payrollNotes == null ||
         (request.resource.data.payrollNotes is string &&
          request.resource.data.payrollNotes.size() <= 500));
    }

    function isAuthoritativeWorkLogCustomSettlementUpdate() {
      let changedFields = request.resource.data.diff(resource.data).affectedKeys();

      return changedFields.hasOnly([
          'customSalaryInfo',
          'customAllowances',
          'customTaxSettings',
          'settlementModificationHistory',
          'updatedAt'
        ]) &&
        changedFields.hasAny([
          'customSalaryInfo',
          'customAllowances',
          'customTaxSettings',
          'settlementModificationHistory'
        ]) &&
        changedFields.hasAll(['updatedAt']) &&
        request.resource.data.updatedAt == request.time &&
        (!changedFields.hasAny(['customSalaryInfo']) ||
         (request.resource.data.customSalaryInfo is map &&
          request.resource.data.customSalaryInfo.keys().hasAll(['type', 'amount']) &&
          request.resource.data.customSalaryInfo.keys().hasOnly(['type', 'amount']) &&
          request.resource.data.customSalaryInfo.type in ['hourly', 'daily', 'monthly', 'other'] &&
          request.resource.data.customSalaryInfo.amount is number &&
          request.resource.data.customSalaryInfo.amount >= 0)) &&
        (!changedFields.hasAny(['customAllowances']) ||
         request.resource.data.customAllowances == null ||
         request.resource.data.customAllowances is map) &&
        (!changedFields.hasAny(['customTaxSettings']) ||
         (request.resource.data.customTaxSettings is map &&
          request.resource.data.customTaxSettings.keys().hasAll(['type', 'value']) &&
          request.resource.data.customTaxSettings.keys().hasOnly(['type', 'value', 'taxableItems']) &&
          request.resource.data.customTaxSettings.type in ['none', 'rate', 'fixed'] &&
          request.resource.data.customTaxSettings.value is number &&
          (!('taxableItems' in request.resource.data.customTaxSettings) ||
           validateTaxableItemsMap(request.resource.data.customTaxSettings.taxableItems)))) &&
        (!changedFields.hasAny(['settlementModificationHistory']) ||
         request.resource.data.settlementModificationHistory is list);
    }

    function isAuthoritativeWorkLogRoleUpdate() {
      let changedFields = request.resource.data.diff(resource.data).affectedKeys();

      return changedFields.hasOnly(['role', 'customRole', 'roleChangeHistory', 'updatedAt']) &&
        changedFields.hasAll(['role', 'updatedAt']) &&
        request.resource.data.updatedAt == request.time &&
        isValidWorkLogRole(request.resource.data.role) &&
        (!changedFields.hasAny(['customRole']) ||
         request.resource.data.customRole == null ||
         (request.resource.data.customRole is string &&
          request.resource.data.customRole.size() <= 50)) &&
        (!changedFields.hasAny(['roleChangeHistory']) ||
         request.resource.data.roleChangeHistory is list);
    }

    function isAuthoritativeWorkLogLifecycleUpdate() {
      let changedFields = request.resource.data.diff(resource.data).affectedKeys();

      return changedFields.hasOnly([
          'status',
          'noShowReason',
          'noShowAt',
          'cancelledReason',
          'cancelledAt',
          'updatedAt'
        ]) &&
        changedFields.hasAll(['status', 'updatedAt']) &&
        request.resource.data.updatedAt == request.time &&
        isValidWorkLogStatus(request.resource.data.status) &&
        (!changedFields.hasAny(['noShowReason']) ||
         request.resource.data.noShowReason == null ||
         (request.resource.data.noShowReason is string &&
          request.resource.data.noShowReason.size() <= 500)) &&
        (!changedFields.hasAny(['noShowAt']) ||
         request.resource.data.noShowAt == null ||
         request.resource.data.noShowAt is timestamp) &&
        (!changedFields.hasAny(['cancelledReason']) ||
         request.resource.data.cancelledReason == null ||
         (request.resource.data.cancelledReason is string &&
          request.resource.data.cancelledReason.size() <= 500)) &&
        (!changedFields.hasAny(['cancelledAt']) ||
         request.resource.data.cancelledAt == null ||
         request.resource.data.cancelledAt is timestamp);
    }

    function isAuthoritativeNegativeSettlementFlagUpdate() {
      let changedFields = request.resource.data.diff(resource.data).affectedKeys();

      return changedFields.hasOnly([
          '_negativeSettlementDetected',
          '_negativeSettlementAmount',
          '_negativeSettlementDetectedAt'
        ]) &&
        changedFields.hasAll([
          '_negativeSettlementDetected',
          '_negativeSettlementAmount',
          '_negativeSettlementDetectedAt'
        ]) &&
        request.resource.data._negativeSettlementDetected == true &&
        request.resource.data._negativeSettlementAmount is number &&
        request.resource.data._negativeSettlementDetectedAt == request.time;
    }

    function isStaffWorkLogCheckInOutUpdate() {
      let changedFields = request.resource.data.diff(resource.data).affectedKeys();

      return request.auth.uid == resource.data.staffId &&
        request.resource.data.staffId == resource.data.staffId &&
        request.resource.data.jobPostingId == resource.data.jobPostingId &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.date == resource.data.date &&
        request.resource.data.timeSlot == resource.data.timeSlot &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.customRole == resource.data.customRole &&
        request.resource.data.updatedAt == request.time &&
        (
          (
            resource.data.status == 'scheduled' &&
            request.resource.data.status == 'checked_in' &&
            changedFields.hasOnly(['status', 'checkInTime', 'updatedAt']) &&
            request.resource.data.checkInTime == request.time &&
            request.resource.data.checkOutTime == resource.data.checkOutTime &&
            request.resource.data.workDuration == resource.data.workDuration
          ) ||
          (
            resource.data.status == 'checked_in' &&
            request.resource.data.status == 'checked_out' &&
            changedFields.hasOnly(['status', 'checkOutTime', 'updatedAt']) &&
            request.resource.data.checkInTime == resource.data.checkInTime &&
            request.resource.data.checkOutTime == request.time &&
            request.resource.data.workDuration == resource.data.workDuration
          )
        );
    }

    // ================= Collection Rules =================

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isPrivileged());

      // 관리자(admin)만 모든 쓰기 가능
      allow write: if isSignedIn() && isAdmin();

      // 본인 문서 생성 (role은 반드시 'staff' — 권한 상승 방지)
      // 회원가입은 verifyAndSaveProfile CF(Admin SDK)를 경유하므로 이 규칙은 방어적 백업
      allow create: if isSignedIn() && isOwner(userId) &&
        request.resource.data.role == 'staff';

      // 본인 문서 수정: 일반 업데이트 또는 구인자 등록
      // bubbleScore: 트랜잭션 내에서만 업데이트 (클라이언트 직접 수정 차단)
      allow update: if isSignedIn() && isOwner(userId) && (
        // 일반 프로필 업데이트 (role, bubbleScore 변경 불가)
        isValidSelfUserUpdate() ||
        // 푸시 토큰 업데이트 (users/{uid}.fcmTokens Map 구조)
        isValidFcmTokenSelfUpdate() ||
        // 구인자 등록 (staff → employer)
        isValidEmployerRegistration()
      );

      // 본인 문서 삭제 불가 (계정 삭제는 Cloud Functions 통해서만)
      allow delete: if false;

      // Subcollection: profile (사용자 프로필 - 공개 정보)
      match /profile/{profileId} {
        // 모든 인증된 사용자가 읽기 가능 (닉네임 등 공개 정보)
        allow read: if isSignedIn();
        // 본인만 쓰기 가능
        allow write: if isSignedIn() && isOwner(userId);
      }

      // Subcollection: myApplications (사용자의 지원 내역)
      match /myApplications/{appId} {
        allow read: if isSignedIn() && (isOwner(userId) || isPrivileged());
        allow write: if isSignedIn() && (isOwner(userId) || isPrivileged());
      }

      // Subcollection: myWorkSessions (사용자의 근무 세션)
      match /myWorkSessions/{sessionId} {
        allow read: if isSignedIn() && (isOwner(userId) || isPrivileged());
        allow write: if isSignedIn() && (isOwner(userId) || isPrivileged());
      }

      // Subcollection: settings (사용자 설정)
      match /settings/{settingId} {
        // 본인의 설정만 읽기/쓰기 가능
        allow read, write: if isSignedIn() && isOwner(userId);
      }

      // Subcollection: counters (카운터 - 미읽음 알림 수 등)
      match /counters/{counterId} {
        // 본인의 카운터만 읽기 가능
        allow read: if isSignedIn() && isOwner(userId);
        // 쓰기는 Cloud Functions에서만 가능 (클라이언트 직접 수정 차단)
        allow write: if false;
      }

      // --- Account Management Subcollections ---

      // Subcollection: consents (동의 관리)
      match /consents/{consentId} {
        // 본인의 동의 정보만 읽기 가능, 관리자는 감사 목적으로 읽기 가능
        allow read: if isSignedIn() && (isOwner(userId) || isPrivileged());

        // 본인만 동의 정보 생성/수정 가능
        allow create: if isSignedIn() && isOwner(userId) &&
          (
            (consentId == 'employer_registration' &&
             isValidEmployerRegistrationConsent(userId) &&
             get(/databases/$(database)/documents/users/$(userId)).data.role == 'staff' &&
             getAfter(/databases/$(database)/documents/users/$(userId)).data.role == 'employer' &&
             getAfter(/databases/$(database)/documents/users/$(userId)).data.employerAgreements.termsVersion ==
               request.resource.data.terms.version &&
             getAfter(/databases/$(database)/documents/users/$(userId)).data.employerAgreements.liabilityWaiverVersion ==
               request.resource.data.liabilityWaiver.version) ||
            (consentId != 'employer_registration' && isValidGenericConsentDocument(userId))
          );

        allow update: if isSignedIn() && isOwner(userId) &&
          consentId != 'employer_registration' &&
          isValidGenericConsentDocument(userId);

        // 동의 정보는 삭제 불가 (법적 요구사항)
        allow delete: if false;
      }

      // Subcollection: consentHistory (동의 변경 이력)
      match /consentHistory/{historyId} {
        // 본인의 이력만 읽기 가능, 관리자는 감사 목적으로 읽기 가능
        allow read: if isSignedIn() && (isOwner(userId) || isPrivileged());

        // 이력은 시스템에서만 생성 가능 (클라이언트 직접 생성 불가)
        allow create: if isSignedIn() && isOwner(userId) &&
          request.resource.data.keys().hasAll(['timestamp', 'changedFields', 'previousValues', 'newValues']);

        // 이력은 수정/삭제 불가 (감사 추적 보존)
        allow update, delete: if false;
      }

      // Subcollection: deletionRequests (계정 삭제 요청)
      match /deletionRequests/{requestId} {
        // 본인의 삭제 요청만 읽기 가능, 관리자는 처리 목적으로 읽기 가능
        allow read: if isSignedIn() && (isOwner(userId) || isPrivileged());

        // 본인만 삭제 요청 생성 가능
        allow create: if isSignedIn() && isOwner(userId) &&
          request.resource.data.keys().hasAll(['requestId', 'userId', 'userEmail', 'userName', 'requestedAt', 'scheduledDeletionAt', 'status']) &&
          request.resource.data.userId == userId &&
          request.resource.data.status == 'pending';

        // 본인은 취소만 가능, 관리자(admin)만 모든 상태 변경 가능
        allow update: if isSignedIn() && (
          (isOwner(userId) && request.resource.data.status == 'cancelled') ||
          isAdmin()
        );

        // 삭제는 관리자(admin)만 가능
        allow delete: if isAdmin();
      }

      // Subcollection: loginHistory (로그인 이력)
      match /loginHistory/{historyId} {
        // 본인의 로그인 이력만 읽기 가능, 관리자는 보안 감사 목적으로 읽기 가능
        allow read: if isSignedIn() && (isOwner(userId) || isPrivileged());

        // 로그인 이력은 서버에서만 생성 가능 (Firebase Functions)
        // 클라이언트에서 직접 생성하는 것은 보안상 차단
        allow create: if false;

        // 로그인 이력은 수정/삭제 불가 (보안 감사 추적 보존)
        allow update, delete: if false;
      }

      // Subcollection: securitySettings (보안 설정)
      match /securitySettings/{settingId} {
        // 본인의 보안 설정만 읽기/쓰기 가능
        allow read: if isSignedIn() && isOwner(userId);

        // 본인만 보안 설정 생성/수정 가능
        allow create, update: if isSignedIn() && isOwner(userId);

        // 보안 설정 삭제는 계정 삭제 시에만 가능 (관리자 admin)
        allow delete: if isAdmin();
      }

      // Subcollection: penalties (패널티 관리)
      match /penalties/{penaltyId} {
        // 읽기: 본인 또는 관리자 가능
        allow read: if isSignedIn() && (request.auth.uid == userId || isPrivileged());

        // 생성: 관리자(admin)만 가능
        allow create: if isSignedIn() && isAdmin() &&
          request.resource.data.keys().hasAll(['userId', 'type', 'reason', 'duration', 'startDate', 'status', 'createdBy']) &&
          request.resource.data.userId == userId &&
          request.resource.data.type in ['warning', 'loginBlock'] &&
          isSafeText(request.resource.data.reason, 100) &&
          request.resource.data.duration in ['1d', '3d', '7d', '30d', '90d', 'permanent'] &&
          request.resource.data.status == 'active';

        // 수정: 관리자(admin)만 가능 (취소 처리)
        allow update: if isSignedIn() && isAdmin();

        // 삭제: 관리자만 가능
        allow delete: if isAdmin();
      }
    }

    // --- Events Collection ---
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow write: if isPrivileged();
    }

    // --- Assignments Collection ---
    match /assignments/{assignmentId} {
      allow read: if isSignedIn() && (isPrivileged() || request.auth.uid == resource.data.dealerId);
      allow create, update, delete: if isPrivileged();
    }
    
    // --- Payrolls Collection ---
    match /payrolls/{payrollId} {
      allow read: if isSignedIn() && (isPrivileged() || request.auth.uid == resource.data.dealerId);
      allow create, update, delete: if isPrivileged();
    }

    // --- Ratings Collection ---
    match /ratings/{ratingId} {
      allow read: if isSignedIn() && (isPrivileged() || request.auth.uid == resource.data.dealerId);
      allow create: if isPrivileged();
      allow update, delete: if false; // Ratings are immutable
    }

    // --- Announcements Collection ---
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if isPrivileged();
    }

    // --- Notifications Collection ---
    // ✅ 보안 강화: 클라이언트 알림 생성 완전 차단 (Cloud Functions만 가능)
    match /notifications/{notificationId} {
      // 본인의 알림만 읽기 가능 (recipientId 또는 userId 필드 기반 - 하위 호환성)
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.recipientId ||
        request.auth.uid == resource.data.userId
      );

      // 본인의 알림만 읽음 처리 및 삭제 가능
      // _batchUpdate: markAllAsRead 배치 업데이트 시 onNotificationRead 트리거 스킵 플래그
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.recipientId ||
        request.auth.uid == resource.data.userId
      ) && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isRead', 'readAt', '_batchUpdate']) &&
        (!('_batchUpdate' in request.resource.data) || request.resource.data._batchUpdate is bool);

      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.recipientId ||
        request.auth.uid == resource.data.userId
      );

      // ❌ 클라이언트 생성 완전 차단 (Cloud Functions만 가능)
      allow create: if false;
    }

    // --- Staff Availability ---
    match /staffAvailability/{staffId} {
        allow read: if isSignedIn() && (isOwner(staffId) || isPrivileged());
        allow write: if isSignedIn() && isOwner(staffId);
    }

    // --- Job Postings Collection ---
    match /jobPostings/{postId} {
      // Public detail and list reads share the same active-only visibility.
      allow get: if isSignedIn() ||
        resource.data.status == 'active';
      allow list: if isSignedIn() ||
        resource.data.status == 'active';

      // Admin can create/update any job posting
      // Employer and manager can create job postings and update their own
      // v2.0: 앱 타입 정의에 맞춘 status 허용 값 + location 객체 지원
      allow create: if canManageJobPostings() &&
        validateCanonicalJobPostingCreate(request.resource.data) &&
        request.resource.data.ownerId == request.auth.uid;
        // 추가 필드 검증
        // 타입별 config 검증 (timestamp 타입 체크 제거됨)

      // Admin can update any job posting, employer/manager can update their own
      // Tournament 승인은 admin만 가능
      allow update: if canManageJobPostings() &&
        (isAdmin() || request.auth.uid == resource.data.ownerId) &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.postingType == resource.data.postingType &&
        (isAdmin() ||
         !('tournamentConfig' in request.resource.data) ||
         (resource.data.postingType == 'tournament' &&
          request.resource.data.tournamentConfig.approvalStatus ==
            resource.data.tournamentConfig.approvalStatus)) &&
        validateCanonicalJobPostingUpdate(request.resource.data, resource.data);

      allow update: if false;
         /* legacy duplicate condition removed
         // (tournament approval check handled above)
         // duplicate line removed
         // duplicate line removed
         // Tournament 승인 필드는 admin만 수정 가능
         (!('tournamentConfig' in request.resource.data) ||
         // legacy duplicate line removed
         // legacy duplicate line removed
         // legacy duplicate line removed
         // legacy duplicate line removed
        // serverTimestamp()는 센티넬 값이므로 is timestamp 검증 불가 - updatedAt 검증 제거

      // Phase 4: 조회수 증가 권한 (로그인한 사용자는 누구나 조회수 증가 가능)
      // fixedData.viewCount 필드만 변경되는 경우 허용
      */
      allow update: if isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount']) &&
        request.resource.data.viewCount is number &&
        resource.data.viewCount is number &&
        request.resource.data.viewCount == resource.data.viewCount + 1;

      // Admin can delete any job posting, Manager/Staff can delete their own
      allow delete: if (isAdmin()) ||
        (hasValidRole() && request.auth.uid == resource.data.ownerId);
        
      // --- Subcollections for Job Postings ---
      // Staff subcollection
      match /staff/{userId} {
        allow read: if isSignedIn();
        allow write: if isPrivileged() ||
          (hasValidRole() && get(/databases/$(database)/documents/jobPostings/$(postId)).data.ownerId == request.auth.uid);
      }

      // WorkLogs subcollection
      match /workLogs/{workLogId} {
        allow read: if isSignedIn() &&
          doesWorkLogMatchJobPosting(postId, resource.data) &&
          canReadWorkLog(resource.data);

        allow create: if isSignedIn() &&
          isDatedWorkLogCreate(request.resource.data) &&
          doesWorkLogMatchJobPosting(postId, request.resource.data) &&
          (
            isAdmin() ||
            (isPrivileged() && request.resource.data.ownerId == request.auth.uid)
          );

        allow update: if doesWorkLogMatchJobPosting(postId, resource.data) &&
          doesWorkLogMatchJobPosting(postId, request.resource.data) &&
          (
            isStaffWorkLogCheckInOutUpdate() ||
            (
              canManageWorkLogAuthoritatively() && (
                isAuthoritativeWorkLogTimeUpdate() ||
                isAuthoritativeWorkLogSettlementUpdate() ||
                isAuthoritativeWorkLogCustomSettlementUpdate() ||
                isAuthoritativeWorkLogRoleUpdate() ||
                isAuthoritativeWorkLogLifecycleUpdate() ||
                isAuthoritativeNegativeSettlementFlagUpdate()
              )
            )
          );

        allow delete: if doesWorkLogMatchJobPosting(postId, resource.data) &&
          canManageWorkLogAuthoritatively();
      }

      // Hybrid Architecture: Applications subcollection (공고별 지원서)
      match /applications/{appId} {
        allow read: if isSignedIn() && (
          isPrivileged() ||
          get(/databases/$(database)/documents/jobPostings/$(postId)).data.ownerId == request.auth.uid
        );
        allow write: if isSignedIn() && (
          isPrivileged() ||
          get(/databases/$(database)/documents/jobPostings/$(postId)).data.ownerId == request.auth.uid
        );
      }

      // Hybrid Architecture: WorkSessions subcollection (공고별 근무 세션)
      match /workSessions/{sessionId} {
        allow read: if isSignedIn() && (
          isPrivileged() ||
          get(/databases/$(database)/documents/jobPostings/$(postId)).data.ownerId == request.auth.uid
        );
        allow write: if isSignedIn() && (
          isPrivileged() ||
          get(/databases/$(database)/documents/jobPostings/$(postId)).data.ownerId == request.auth.uid
        );
      }

      // Hybrid Architecture: Attendance subcollection (공고별 출석)
      match /attendance/{recordId} {
        allow read: if isSignedIn() && (
          isPrivileged() ||
          get(/databases/$(database)/documents/jobPostings/$(postId)).data.ownerId == request.auth.uid
        );
        allow write: if isSignedIn() && (
          isPrivileged() ||
          get(/databases/$(database)/documents/jobPostings/$(postId)).data.ownerId == request.auth.uid
        );
      }

      // Hybrid Architecture: Payroll subcollection (공고별 정산)
      match /payroll/{payrollId} {
        allow read: if isSignedIn() && (
          isPrivileged() ||
          get(/databases/$(database)/documents/jobPostings/$(postId)).data.ownerId == request.auth.uid
        );
        allow write: if isSignedIn() && (
          isPrivileged() ||
          get(/databases/$(database)/documents/jobPostings/$(postId)).data.ownerId == request.auth.uid
        );
      }
    }

    // --- Applications Collection (jobPostingId 통일) ---
    match /applications/{applicationId} {
      // 본인 지원서, 공고 소유자, 관리자만 읽기 가능
      allow read: if isSignedIn() && (
        isPrivileged() ||
        canReadOwnMissingApplication(applicationId) ||
        request.auth.uid == resource.data.applicantId ||
        (resource.data.keys().hasAny(['jobPostingId']) &&
         exists(/databases/$(database)/documents/jobPostings/$(resource.data.jobPostingId)) &&
         get(/databases/$(database)/documents/jobPostings/$(resource.data.jobPostingId)).data.ownerId == request.auth.uid)
      );

      // 사용자는 본인 지원서 생성 가능
      allow create: if isCanonicalApplicationCreate(applicationId) &&
        request.resource.data.keys().hasAll(['applicantId', 'status']) &&
        (request.resource.data.keys().hasAny(['jobPostingId', 'postId', 'eventId'])) &&  // jobPostingId 우선, 하위 호환성 유지
        request.resource.data.status == 'applied' &&
        (!('preQuestionAnswers' in request.resource.data) || request.resource.data.preQuestionAnswers is list);

      // 관리자 및 구인공고 작성자가 지원서 수정 가능
      // status enum 검증: 허용값 출처 application.schema.ts
      allow update: if (
        (
          isSignedIn() &&
          request.auth.uid == resource.data.applicantId &&
          canApplicantUpdateOwnApplication()
        ) ||
        (
          canOwnerUpdateApplicationLifecycle()
        )
      ) &&
        (!('status' in request.resource.data) ||
         request.resource.data.status in
         ['applied', 'confirmed', 'rejected', 'cancelled', 'completed', 'cancellation_pending']);

      // 사용자는 본인 지원서 삭제 가능, 관리자 및 구인공고 작성자도 삭제 가능
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.applicantId ||
        isPrivileged() ||
        (hasValidRole() && (
          (resource.data.keys().hasAny(['jobPostingId']) && exists(/databases/$(database)/documents/jobPostings/$(resource.data.jobPostingId)) &&
           get(/databases/$(database)/documents/jobPostings/$(resource.data.jobPostingId)).data.ownerId == request.auth.uid) ||
          (resource.data.keys().hasAny(['postId']) && exists(/databases/$(database)/documents/jobPostings/$(resource.data.postId)) &&
           get(/databases/$(database)/documents/jobPostings/$(resource.data.postId)).data.ownerId == request.auth.uid) ||
          (resource.data.keys().hasAny(['eventId']) && exists(/databases/$(database)/documents/jobPostings/$(resource.data.eventId)) &&
           get(/databases/$(database)/documents/jobPostings/$(resource.data.eventId)).data.ownerId == request.auth.uid)
        ))
      );
    }

    // --- Staff Collection (최적화 서비스 지원) ---
    match /staff/{staffId} {
      // 인증된 사용자가 스태프 정보 읽기 가능
      allow read: if isSignedIn() && (
        hasValidRole() ||
        request.auth.uid == resource.data.userId ||
        request.auth.uid == staffId
      );

      // 관리자 또는 본인만 스태프 정보 생성/수정 가능
      allow create: if isSignedIn() && (
        isAdmin() ||
        (hasValidRole() && request.auth.uid == request.resource.data.userId)
      );

      allow update: if isSignedIn() && (
        isAdmin() ||
        (hasValidRole() && request.auth.uid == resource.data.userId)
      );

      // 관리자만 삭제 가능
      allow delete: if isPrivileged();
    }

    // --- Work Logs Collection (표준 필드명 + 최적화 지원) ---
    match /workLogs/{workLogId} {
      // 본인 근무기록, 공고 소유자, 관리자만 읽기 가능
      // ownerId 직접 비교: 리스트 쿼리에서 get() 교차조회 불가 문제 해결
      allow read: if isSignedIn() && (
        isAdmin() ||
        request.auth.uid == resource.data.staffId ||
        (isPrivileged() && request.auth.uid == resource.data.ownerId) ||
        (isPrivileged() &&
         exists(/databases/$(database)/documents/jobPostings/$(resource.data.jobPostingId)) &&
         get(/databases/$(database)/documents/jobPostings/$(resource.data.jobPostingId)).data.ownerId == request.auth.uid)
      );

      // 관리자 및 유효한 역할을 가진 사용자가 생성/수정 가능
      // Phase 2: jobPostingId 사용 (eventId 대신)
      allow create: if isSignedIn() &&
        isDatedWorkLogCreate(request.resource.data) &&
        request.resource.data.jobPostingId is string &&
        request.resource.data.ownerId is string &&
        exists(/databases/$(database)/documents/jobPostings/$(request.resource.data.jobPostingId)) &&
        request.resource.data.ownerId ==
          get(/databases/$(database)/documents/jobPostings/$(request.resource.data.jobPostingId)).data.ownerId &&
        (
          isAdmin() ||
          (hasValidRole() &&
           request.resource.data.ownerId == request.auth.uid)
        );

      // 소유자/공고작성자/admin만 수정 가능 + status/payrollStatus enum 검증
      // 허용값 출처: workLog.schema.ts, statusValues.ts
      allow update: if isStaffWorkLogCheckInOutUpdate() || (
        canManageWorkLogAuthoritatively() && (
          isAuthoritativeWorkLogTimeUpdate() ||
          isAuthoritativeWorkLogSettlementUpdate() ||
          isAuthoritativeWorkLogCustomSettlementUpdate() ||
          isAuthoritativeWorkLogRoleUpdate() ||
          isAuthoritativeWorkLogLifecycleUpdate() ||
          isAuthoritativeNegativeSettlementFlagUpdate()
        )
      );

      // 삭제 권한: Admin/Manager 또는 해당 공고 작성자 (Staff 포함)
      allow delete: if canManageWorkLogAuthoritatively();

      match /timeModificationLogs/{logId} {
        allow read: if canReadTimeModificationLog(resource.data);
        allow create: if canCreateTimeModificationLog(workLogId);
        allow update, delete: if false;
      }
    }

    // --- Participants Collection ---
    match /participants/{participantId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isPrivileged();
    }

    // --- Tables Collection ---
    match /tables/{tableId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isPrivileged();
    }

    // --- Shift Schedules Collection ---
    match /shiftSchedules/{scheduleId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isPrivileged();
    }

    // --- Attendance Collection ---
    match /attendance/{attendanceId} {
      allow read: if isSignedIn() && (hasValidRole() || request.auth.uid == resource.data.userId);
      allow create, update: if isSignedIn() && hasValidRole();
      allow delete: if isPrivileged();
    }

    // --- Job Posting Drafts Collection (임시저장) ---
    match /jobPostingDrafts/{draftId} {
      // Helper: 공고 관리 권한 확인 (hasValidRole에 employer 포함됨)
      // 개별 문서 읽기: 본인의 임시저장만 가능
      allow get: if isSignedIn() && canManageJobPostings() &&
        request.auth.uid == resource.data.ownerId;

      // 쿼리(list): 공고 관리 권한이 있는 사용자만 가능 (실제 결과는 where ownerId 조건으로 필터링)
      allow list: if isSignedIn() && canManageJobPostings();

      // 생성: 본인 이름으로만 생성 가능 (공고 관리 권한 필요)
      allow create: if isSignedIn() && canManageJobPostings() &&
        request.auth.uid == request.resource.data.ownerId &&
        request.resource.data.keys().hasAll(['ownerId', 'step', 'lastSavedAt', 'draft']) &&
        request.resource.data.keys().hasOnly(['ownerId', 'step', 'lastSavedAt', 'draft']) &&
        request.resource.data.step is number &&
        request.resource.data.lastSavedAt == request.time &&
        request.resource.data.draft is map;

      // 수정: 본인의 임시저장만 수정 가능
      allow update: if isSignedIn() && canManageJobPostings() &&
        request.auth.uid == resource.data.ownerId &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.keys().hasOnly(['ownerId', 'step', 'lastSavedAt', 'draft']) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['step', 'lastSavedAt', 'draft']) &&
        request.resource.data.step is number &&
        request.resource.data.lastSavedAt == request.time &&
        request.resource.data.draft is map;

      // 삭제: 본인의 임시저장만 삭제 가능
      allow delete: if isSignedIn() && canManageJobPostings() &&
        request.auth.uid == resource.data.ownerId;
    }

    // --- Job Posting Templates Collection ---
    match /jobPostingTemplates/{templateId} {
      // Users can read their own templates, privileged users can read all
      allow read: if isSignedIn() && (
        isPrivileged() ||
        (resource != null && isOwner(resource.data.createdBy))
      );

      // Users can create templates for themselves, privileged users can create for anyone
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasAll(['name', 'templateData', 'createdBy', 'createdAt']) &&
        (isPrivileged() || isOwner(request.resource.data.createdBy)) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 2 &&
        request.resource.data.name.size() <= 50 &&
        (!('description' in request.resource.data) || request.resource.data.description is string) &&
        request.resource.data.templateData is map &&
        request.resource.data.createdBy is string &&
        (!('usageCount' in request.resource.data) || request.resource.data.usageCount is number) &&
        (!('isPublic' in request.resource.data) || request.resource.data.isPublic is bool);

      // Users can update their own templates, privileged users can update all
      allow update: if isSignedIn() && (
        isPrivileged() ||
        (resource != null && isOwner(resource.data.createdBy))
      );

      // Users can delete their own templates, privileged users can delete all
      allow delete: if isSignedIn() && (
        isPrivileged() ||
        (resource != null && isOwner(resource.data.createdBy))
      );
    }

    // --- Mobile Job Posting Templates Collection (모바일 앱 전용) ---
    match /mobileJobPostingTemplates/{templateId} {
      // 읽기: 본인의 템플릿만 가능, 관리자는 전체 조회 가능
      allow read: if isSignedIn() && (
        isPrivileged() ||
        (resource != null && isOwner(resource.data.createdBy))
      );

      // 생성: 본인 이름으로만 생성 가능 (공고 관리 권한 필요)
      allow create: if isSignedIn() && hasValidRole() &&
        request.resource.data.keys().hasAll(['name', 'templateData', 'createdBy', 'createdAt']) &&
        isOwner(request.resource.data.createdBy) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 2 &&
        request.resource.data.name.size() <= 50 &&
        (!('description' in request.resource.data) || request.resource.data.description is string) &&
        request.resource.data.templateData is map &&
        request.resource.data.createdBy is string &&
        (!('usageCount' in request.resource.data) || request.resource.data.usageCount is number) &&
        (!('lastUsedAt' in request.resource.data) || request.resource.data.lastUsedAt is timestamp);

      // 수정: 본인의 템플릿만 수정 가능 (usageCount 증가 등)
      allow update: if isSignedIn() && (
        isPrivileged() ||
        (resource != null && isOwner(resource.data.createdBy))
      );

      // 삭제: 본인의 템플릿만 삭제 가능
      allow delete: if isSignedIn() && (
        isPrivileged() ||
        (resource != null && isOwner(resource.data.createdBy))
      );
    }

    // --- Tournaments Collection ---
    match /tournaments/{tournamentId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isPrivileged();
    }

    // ================= 멀티 테넌트 아키텍처 =================
    // users/{userId}/tournaments/{tournamentId} 구조

    match /users/{userId}/tournaments/{tournamentId} {
      // 본인의 토너먼트만 읽기/쓰기 가능 (관리자는 모든 토너먼트 접근 가능)
      allow read: if isSignedIn() && (isOwner(userId) || isPrivileged());
      allow write: if isSignedIn() && (isOwner(userId) || isPrivileged());

      // --- Participants Subcollection ---
      match /participants/{participantId} {
        allow read: if isSignedIn() && (isOwner(userId) || isPrivileged());
        allow create, update, delete: if isSignedIn() && (isOwner(userId) || isPrivileged());
      }

      // --- Tables Subcollection ---
      match /tables/{tableId} {
        allow read: if isSignedIn() && (isOwner(userId) || isPrivileged());
        allow create, update, delete: if isSignedIn() && (isOwner(userId) || isPrivileged());
      }

      // --- Settings Subcollection ---
      match /settings/{settingId} {
        allow read: if isSignedIn() && (isOwner(userId) || isPrivileged());
        allow create, update: if isSignedIn() && (isOwner(userId) || isPrivileged());
        allow delete: if isPrivileged(); // 관리자만 삭제 가능
      }
    }

    // ================= collectionGroup 쿼리 지원 =================
    // collectionGroup('tables') 등의 쿼리를 위한 규칙
    match /{path=**}/tables/{tableId} {
      // users/{userId}/tournaments/{tournamentId}/tables/{tableId} 경로의 모든 테이블
      // 인증된 사용자만 읽을 수 있음 (본인 또는 관리자)
      allow read: if isSignedIn();
      // 쓰기는 상위 규칙 (users/{userId}/tournaments/{tournamentId}/tables) 적용
    }

    // collectionGroup('participants') 쿼리를 위한 규칙
    match /{path=**}/participants/{participantId} {
      // users/{userId}/tournaments/{tournamentId}/participants/{participantId} 경로의 모든 참가자
      // 인증된 사용자만 읽을 수 있음 (본인 또는 관리자)
      allow read: if isSignedIn();
      // 쓰기는 상위 규칙 (users/{userId}/tournaments/{tournamentId}/participants) 적용
    }

    match /{path=**}/timeModificationLogs/{logId} {
      allow read: if canReadTimeModificationLog(resource.data);
    }
    
    // --- Attendance Records Collection (표준 필드명 지원) ---
    match /attendanceRecords/{recordId} {
      // 표준 필드명 기반 권한 체크
      allow read: if isSignedIn() && (
        hasValidRole() ||
        request.auth.uid == resource.data.staffId ||  // 표준 필드명
        request.auth.uid == resource.data.dealerId    // 하위 호환성
      );
      allow create, update: if isSignedIn() && hasValidRole();
      allow delete: if isPrivileged();
    }
    
    // --- Persons Collection --- [DEPRECATED - Use WorkLog.staffInfo instead]
    // Persons 컬렉션이 WorkLog.staffInfo로 통합됨 
    // 하위 호환성을 위해 읽기만 허용, 새로운 생성/수정은 제한
    match /persons/{personId} {
      // 기존 데이터 읽기만 허용 (마이그레이션 및 하위 호환성용)
      allow read: if isSignedIn();
      // 새로운 생성/수정/삭제는 제한 - WorkLog 사용 권장
      allow create, update, delete: if false;
    }
    
    // --- Applicants Collection --- [DEPRECATED - Use /persons collection instead]
    // Removed - All applicant operations should use /persons collection with type='applicant' or 'both'
    
    // --- Work Sessions Collection (다중 세션 지원) ---
    match /workSessions/{sessionId} {
      allow read: if isSignedIn() && (hasValidRole() || request.auth.uid == resource.data.personId);
      allow create, update: if isSignedIn() && hasValidRole();
      allow delete: if isPrivileged();
    }
    
    // --- Migration Backups Collection ---
    match /migration_backups/{backupId} {
      // 관리자만 접근 가능
      allow read, write: if isAdmin();
    }
    
    // --- Backup Collections (와일드카드 패턴) ---
    // staff_backup_YYYY-MM-DD 형식의 모든 백업 컬렉션
    match /{backupCollection}/{documentId} {
      allow read, write: if isAdmin() &&
        (backupCollection.matches('staff_backup_.*') ||
         backupCollection.matches('applicants_backup_.*') ||
         backupCollection.matches('persons_backup_.*'));
    }

    // --- Login Attempts Collection (보안 기능) ---
    match /loginAttempts/{attemptId} {
      // Admin SDK(callableGuard) 전용 — 클라이언트 접근 불필요
      // - 클라이언트 Rate Limiting: SecureStore(로컬) 사용 (sessionService.ts)
      // - 서버 Rate Limiting: callableGuard.ts(Admin SDK) 사용
      allow read, write: if false;
    }

    // --- Account Deletion Requests Collection (계정 삭제 요청) ---
    match /deletionRequests/{requestId} {
      // 본인의 삭제 요청만 읽기 가능, 관리자는 처리 목적으로 읽기 가능
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.userId ||
        isPrivileged()
      );

      // 본인만 삭제 요청 생성 가능
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.userId &&
        request.resource.data.keys().hasAll(['requestId', 'userId', 'userEmail', 'userName', 'requestedAt', 'scheduledDeletionAt', 'status']) &&
        request.resource.data.status == 'pending';

      // 본인은 취소만 가능, 관리자(admin)만 모든 상태 변경 가능
      allow update: if isSignedIn() && (
        (request.auth.uid == resource.data.userId && request.resource.data.status == 'cancelled') ||
        isAdmin()
      );

      // 삭제는 관리자(admin)만 가능
      allow delete: if isAdmin();
    }

    // --- Inquiries Collection (고객 문의) ---
    match /inquiries/{inquiryId} {
      // 읽기: 본인의 문의는 볼 수 있고, 관리자는 모든 문의를 볼 수 있음
      allow read: if isSignedIn() && (
        isPrivileged() ||
        request.auth.uid == resource.data.userId
      );

      // 생성: 로그인한 사용자가 본인 이름으로 문의 생성 가능
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.userId &&
        request.resource.data.keys().hasAll(['userId', 'userEmail', 'userName', 'category', 'subject', 'message', 'status']) &&
        isSafeText(request.resource.data.subject, 200) &&
        isSafeText(request.resource.data.message, 2000) &&
        request.resource.data.category in ['general', 'account', 'technical', 'payment', 'other', 'report'] &&
        request.resource.data.status == 'open' &&
        request.resource.data.userEmail is string &&
        request.resource.data.userName is string;

      // 수정: 관리자만 문의 상태 변경 및 답변 가능
      allow update: if isPrivileged();

      // 삭제: 관리자만 가능
      allow delete: if isPrivileged();
    }

    // --- Unified Board Collections (통합 게시판) ---
    match /boardPosts/{postId} {
      allow read: if canReadBoardPost(postId);

      allow create: if isSignedIn() && (
        (
          request.resource.data.keys().hasAll([
            'boardType',
            'source',
            'title',
            'body',
            'authorId',
            'authorName',
            'authorRole',
            'visibility',
            'status',
            'linkedJobPostingId',
            'isAutoCreated',
            'isLocked',
            'likeCount',
            'dislikeCount',
            'commentCount',
            'viewCount',
            'imageAttachments',
            'lastActivityAt',
            'createdAt',
            'updatedAt'
          ]) &&
          request.resource.data.keys().hasOnly([
            'boardType',
            'source',
            'title',
            'body',
            'authorId',
            'authorName',
            'authorRole',
            'visibility',
            'status',
            'linkedJobPostingId',
            'isAutoCreated',
            'isLocked',
            'lockedBy',
            'lockedAt',
            'likeCount',
            'dislikeCount',
            'commentCount',
            'viewCount',
            'imageAttachments',
            'lastActivityAt',
            'createdAt',
            'updatedAt',
            'announcementCategory',
            'isPinned',
            'jobSummary'
          ]) &&
          isCommunityBoardType(request.resource.data.boardType) &&
          request.resource.data.source == 'board' &&
          isSafeText(request.resource.data.title, 120) &&
          isSafeText(request.resource.data.body, 5000) &&
          request.resource.data.authorId == request.auth.uid &&
          request.resource.data.authorName is string &&
          isBoardAuthorRole(request.resource.data.authorRole) &&
          request.resource.data.visibility == 'public' &&
          request.resource.data.status == 'active' &&
          request.resource.data.linkedJobPostingId == null &&
          request.resource.data.isAutoCreated == false &&
          request.resource.data.isLocked == false &&
          (!('lockedBy' in request.resource.data) || request.resource.data.lockedBy == null) &&
          (!('lockedAt' in request.resource.data) || request.resource.data.lockedAt == null) &&
          request.resource.data.likeCount == 0 &&
          request.resource.data.dislikeCount == 0 &&
          request.resource.data.commentCount == 0 &&
          request.resource.data.viewCount == 0 &&
          isValidBoardImageList(request.resource.data.imageAttachments, 10) &&
          request.resource.data.lastActivityAt == request.time &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.updatedAt == request.time &&
          (!('announcementCategory' in request.resource.data) || request.resource.data.announcementCategory == null) &&
          (!('isPinned' in request.resource.data) || request.resource.data.isPinned == false) &&
          (!('jobSummary' in request.resource.data) || request.resource.data.jobSummary == null)
        ) ||
        (
          request.resource.data.keys().hasAll([
            'boardType',
            'source',
            'title',
            'body',
            'authorId',
            'authorName',
            'authorRole',
            'visibility',
            'status',
            'linkedJobPostingId',
            'isAutoCreated',
            'isLocked',
            'likeCount',
            'dislikeCount',
            'commentCount',
            'viewCount',
            'imageAttachments',
            'lastActivityAt',
            'createdAt',
            'updatedAt',
            'jobSummary'
          ]) &&
          request.resource.data.keys().hasOnly([
            'boardType',
            'source',
            'title',
            'body',
            'authorId',
            'authorName',
            'authorRole',
            'visibility',
            'status',
            'linkedJobPostingId',
            'isAutoCreated',
            'isLocked',
            'lockedBy',
            'lockedAt',
            'likeCount',
            'dislikeCount',
            'commentCount',
            'viewCount',
            'imageAttachments',
            'lastActivityAt',
            'createdAt',
            'updatedAt',
            'jobSummary'
          ]) &&
          request.resource.data.boardType == 'schedule' &&
          request.resource.data.source == 'board' &&
          isSafeText(request.resource.data.title, 120) &&
          isSafeText(request.resource.data.body, 5000) &&
          request.resource.data.linkedJobPostingId is string &&
          isScheduleBoardPostId(postId, request.resource.data.linkedJobPostingId) &&
          canManageLinkedJobPosting(request.resource.data.linkedJobPostingId) &&
          request.resource.data.authorId ==
            get(/databases/$(database)/documents/jobPostings/$(request.resource.data.linkedJobPostingId)).data.ownerId &&
          request.resource.data.authorName is string &&
          isBoardAuthorRole(request.resource.data.authorRole) &&
          request.resource.data.visibility == 'participants_only' &&
          request.resource.data.status == 'active' &&
          request.resource.data.isAutoCreated == true &&
          request.resource.data.isLocked == false &&
          (!('lockedBy' in request.resource.data) || request.resource.data.lockedBy == null) &&
          (!('lockedAt' in request.resource.data) || request.resource.data.lockedAt == null) &&
          request.resource.data.likeCount == 0 &&
          request.resource.data.dislikeCount == 0 &&
          request.resource.data.commentCount == 0 &&
          request.resource.data.viewCount == 0 &&
          isValidBoardImageList(request.resource.data.imageAttachments, 10) &&
          request.resource.data.lastActivityAt == request.time &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.updatedAt == request.time &&
          request.resource.data.jobSummary is map
        )
      );

      allow update: if canReadBoardPost(postId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount']) &&
        request.resource.data.viewCount is number &&
        resource.data.viewCount is number &&
        request.resource.data.viewCount == resource.data.viewCount + 1;

      allow update: if canInteractBoardPost(postId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'commentCount',
          'lastActivityAt',
          'updatedAt'
        ]) &&
        request.resource.data.commentCount is number &&
        resource.data.commentCount is number &&
        request.resource.data.commentCount == resource.data.commentCount + 1 &&
        request.resource.data.lastActivityAt == request.time &&
        request.resource.data.updatedAt == request.time;

      allow update: if canInteractBoardPost(postId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'likeCount',
          'dislikeCount',
          'updatedAt'
        ]) &&
        request.resource.data.likeCount is number &&
        request.resource.data.dislikeCount is number &&
        request.resource.data.likeCount >= 0 &&
        request.resource.data.dislikeCount >= 0 &&
        request.resource.data.updatedAt == request.time &&
        (
          request.resource.data.likeCount == resource.data.likeCount - 1 ||
          request.resource.data.likeCount == resource.data.likeCount ||
          request.resource.data.likeCount == resource.data.likeCount + 1
        ) &&
        (
          request.resource.data.dislikeCount == resource.data.dislikeCount - 1 ||
          request.resource.data.dislikeCount == resource.data.dislikeCount ||
          request.resource.data.dislikeCount == resource.data.dislikeCount + 1
        );

      allow update: if canManageBoardPostData(resource.data) &&
        isCommunityBoardType(resource.data.boardType) &&
        resource.data.isLocked == false &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title',
          'body',
          'imageAttachments',
          'updatedAt',
          'lastActivityAt'
        ]) &&
        isSafeText(request.resource.data.title, 120) &&
        isSafeText(request.resource.data.body, 5000) &&
        isValidBoardImageList(request.resource.data.imageAttachments, 10) &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.lastActivityAt == request.time &&
        request.resource.data.boardType == resource.data.boardType &&
        request.resource.data.authorId == resource.data.authorId &&
        request.resource.data.linkedJobPostingId == resource.data.linkedJobPostingId &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.isLocked == resource.data.isLocked;

      allow update: if resource.data.boardType == 'schedule' &&
        canManageLinkedJobPosting(resource.data.linkedJobPostingId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title',
          'body',
          'authorName',
          'authorRole',
          'jobSummary',
          'updatedAt',
          'lastActivityAt'
        ]) &&
        isSafeText(request.resource.data.title, 120) &&
        isSafeText(request.resource.data.body, 5000) &&
        request.resource.data.authorId == resource.data.authorId &&
        request.resource.data.authorName is string &&
        isBoardAuthorRole(request.resource.data.authorRole) &&
        request.resource.data.linkedJobPostingId == resource.data.linkedJobPostingId &&
        request.resource.data.visibility == resource.data.visibility &&
        request.resource.data.isAutoCreated == resource.data.isAutoCreated &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.isLocked == resource.data.isLocked &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.lastActivityAt == request.time &&
        request.resource.data.jobSummary is map;

      allow update: if canManageBoardPostData(resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isLocked',
          'status',
          'lockedBy',
          'lockedAt',
          'updatedAt'
        ]) &&
        (
          (
            request.resource.data.isLocked == true &&
            request.resource.data.status == 'locked' &&
            request.resource.data.lockedBy == request.auth.uid &&
            request.resource.data.lockedAt == request.time
          ) ||
          (
            request.resource.data.isLocked == false &&
            request.resource.data.status == 'active' &&
            request.resource.data.lockedBy == null &&
            request.resource.data.lockedAt == null
          )
        ) &&
        request.resource.data.updatedAt == request.time;

      allow update: if (
        (
          isAdmin() &&
          request.resource.data.status == 'hidden'
        ) ||
        (
          (isAdmin() || isBoardPostAuthor(resource.data)) &&
          request.resource.data.status == 'archived'
        )
      ) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'updatedAt'
        ]) &&
        request.resource.data.updatedAt == request.time;

      allow delete: if isAdmin();

      match /comments/{commentId} {
        allow read: if canReadBoardPost(postId);

        allow create: if canInteractBoardPost(postId) &&
          request.resource.data.keys().hasAll([
            'postId',
            'body',
            'authorId',
            'authorName',
            'authorRole',
            'mentionedUserIds',
            'reactionCounts',
            'isPinned',
            'status',
            'imageAttachments',
            'createdAt',
            'updatedAt'
          ]) &&
          request.resource.data.keys().hasOnly([
            'postId',
            'parentCommentId',
            'body',
            'authorId',
            'authorName',
            'authorRole',
            'mentionedUserIds',
            'reactionCounts',
            'isPinned',
            'pinnedAt',
            'pinnedBy',
            'status',
            'imageAttachments',
            'createdAt',
            'updatedAt'
          ]) &&
          request.resource.data.postId == postId &&
          (!('parentCommentId' in request.resource.data) ||
            request.resource.data.parentCommentId == null ||
            (
              exists(/databases/$(database)/documents/boardPosts/$(postId)/comments/$(request.resource.data.parentCommentId)) &&
              get(/databases/$(database)/documents/boardPosts/$(postId)/comments/$(request.resource.data.parentCommentId)).data.status == 'active'
            )) &&
          isSafeText(request.resource.data.body, 3000) &&
          request.resource.data.authorId == request.auth.uid &&
          request.resource.data.authorName is string &&
          isBoardAuthorRole(request.resource.data.authorRole) &&
          request.resource.data.mentionedUserIds is list &&
          request.resource.data.mentionedUserIds.size() <= 10 &&
          request.resource.data.reactionCounts is map &&
          request.resource.data.reactionCounts.keys().size() == 0 &&
          request.resource.data.isPinned == false &&
          (!('pinnedAt' in request.resource.data) || request.resource.data.pinnedAt == null) &&
          (!('pinnedBy' in request.resource.data) || request.resource.data.pinnedBy == null) &&
          request.resource.data.status == 'active' &&
          isValidBoardImageList(request.resource.data.imageAttachments, 3) &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.updatedAt == request.time;

        allow update: if canReadBoardPost(postId) &&
          getBoardPostData(postId).isLocked == false &&
          resource.data.status == 'active' &&
          (isAdmin() || request.auth.uid == resource.data.authorId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'body',
            'imageAttachments',
            'updatedAt'
          ]) &&
          request.resource.data.postId == resource.data.postId &&
          request.resource.data.parentCommentId == resource.data.parentCommentId &&
          request.resource.data.authorId == resource.data.authorId &&
          request.resource.data.authorName == resource.data.authorName &&
          request.resource.data.authorRole == resource.data.authorRole &&
          request.resource.data.mentionedUserIds == resource.data.mentionedUserIds &&
          request.resource.data.reactionCounts == resource.data.reactionCounts &&
          request.resource.data.isPinned == resource.data.isPinned &&
          request.resource.data.pinnedAt == resource.data.pinnedAt &&
          request.resource.data.pinnedBy == resource.data.pinnedBy &&
          request.resource.data.status == resource.data.status &&
          request.resource.data.createdAt == resource.data.createdAt &&
          isSafeText(request.resource.data.body, 3000) &&
          isValidBoardImageList(request.resource.data.imageAttachments, 3) &&
          request.resource.data.updatedAt == request.time;

        allow update: if canReadBoardPost(postId) &&
          resource.data.status == 'active' &&
          (
            (isAdmin() && request.resource.data.status == 'hidden') ||
            (
              (
                isAdmin() ||
                (request.auth.uid == resource.data.authorId && getBoardPostData(postId).isLocked == false)
              ) &&
              request.resource.data.status == 'deleted'
            )
          ) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'body',
            'isPinned',
            'pinnedAt',
            'pinnedBy',
            'imageAttachments',
            'mentionedUserIds',
            'updatedAt'
          ]) &&
          request.resource.data.postId == resource.data.postId &&
          request.resource.data.parentCommentId == resource.data.parentCommentId &&
          request.resource.data.authorId == resource.data.authorId &&
          request.resource.data.authorName == resource.data.authorName &&
          request.resource.data.authorRole == resource.data.authorRole &&
          request.resource.data.reactionCounts == resource.data.reactionCounts &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.isPinned == false &&
          request.resource.data.pinnedAt == null &&
          request.resource.data.pinnedBy == null &&
          request.resource.data.imageAttachments == [] &&
          request.resource.data.mentionedUserIds == [] &&
          request.resource.data.body is string &&
          request.resource.data.updatedAt == request.time;

        allow update: if canManageBoardPostData(getBoardPostData(postId)) &&
          resource.data.parentCommentId == null &&
          resource.data.status == 'active' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'isPinned',
            'pinnedAt',
            'pinnedBy',
            'updatedAt'
          ]) &&
          request.resource.data.postId == resource.data.postId &&
          request.resource.data.parentCommentId == resource.data.parentCommentId &&
          request.resource.data.authorId == resource.data.authorId &&
          request.resource.data.authorName == resource.data.authorName &&
          request.resource.data.authorRole == resource.data.authorRole &&
          request.resource.data.mentionedUserIds == resource.data.mentionedUserIds &&
          request.resource.data.reactionCounts == resource.data.reactionCounts &&
          request.resource.data.status == resource.data.status &&
          request.resource.data.body == resource.data.body &&
          request.resource.data.imageAttachments == resource.data.imageAttachments &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.updatedAt == request.time &&
          (
            (
              request.resource.data.isPinned == true &&
              request.resource.data.pinnedBy == request.auth.uid &&
              request.resource.data.pinnedAt == request.time
            ) ||
            (
              request.resource.data.isPinned == false &&
              request.resource.data.pinnedBy == null &&
              request.resource.data.pinnedAt == null
            )
          );

        allow update: if canInteractBoardPost(postId) &&
          resource.data.status == 'active' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'reactionCounts',
            'updatedAt'
          ]) &&
          request.resource.data.postId == resource.data.postId &&
          request.resource.data.parentCommentId == resource.data.parentCommentId &&
          request.resource.data.authorId == resource.data.authorId &&
          request.resource.data.authorName == resource.data.authorName &&
          request.resource.data.authorRole == resource.data.authorRole &&
          request.resource.data.mentionedUserIds == resource.data.mentionedUserIds &&
          request.resource.data.isPinned == resource.data.isPinned &&
          request.resource.data.pinnedAt == resource.data.pinnedAt &&
          request.resource.data.pinnedBy == resource.data.pinnedBy &&
          request.resource.data.status == resource.data.status &&
          request.resource.data.body == resource.data.body &&
          request.resource.data.imageAttachments == resource.data.imageAttachments &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.updatedAt == request.time &&
          request.resource.data.reactionCounts is map &&
          request.resource.data.reactionCounts.keys().hasOnly([
            'thumbs_up',
            'heart',
            'laugh',
            'surprised',
            'sad',
            'angry'
          ]) &&
          (!('thumbs_up' in request.resource.data.reactionCounts) ||
            (request.resource.data.reactionCounts.thumbs_up is number &&
             request.resource.data.reactionCounts.thumbs_up >= 0)) &&
          (!('heart' in request.resource.data.reactionCounts) ||
            (request.resource.data.reactionCounts.heart is number &&
             request.resource.data.reactionCounts.heart >= 0)) &&
          (!('laugh' in request.resource.data.reactionCounts) ||
            (request.resource.data.reactionCounts.laugh is number &&
             request.resource.data.reactionCounts.laugh >= 0)) &&
          (!('surprised' in request.resource.data.reactionCounts) ||
            (request.resource.data.reactionCounts.surprised is number &&
             request.resource.data.reactionCounts.surprised >= 0)) &&
          (!('sad' in request.resource.data.reactionCounts) ||
            (request.resource.data.reactionCounts.sad is number &&
             request.resource.data.reactionCounts.sad >= 0)) &&
          (!('angry' in request.resource.data.reactionCounts) ||
            (request.resource.data.reactionCounts.angry is number &&
             request.resource.data.reactionCounts.angry >= 0));

        allow delete: if isAdmin();

        match /reactions/{userId} {
          allow read: if canReadBoardPost(postId);

          allow create: if canInteractBoardPost(postId) &&
            get(/databases/$(database)/documents/boardPosts/$(postId)/comments/$(commentId)).data.status == 'active' &&
            request.auth.uid == userId &&
            request.resource.data.keys().hasAll([
              'postId',
              'commentId',
              'userId',
              'type',
              'createdAt',
              'updatedAt'
            ]) &&
            request.resource.data.keys().hasOnly([
              'postId',
              'commentId',
              'userId',
              'type',
              'createdAt',
              'updatedAt'
            ]) &&
            request.resource.data.postId == postId &&
            request.resource.data.commentId == commentId &&
            request.resource.data.userId == request.auth.uid &&
            isCommentReactionType(request.resource.data.type) &&
            request.resource.data.createdAt == request.time &&
            request.resource.data.updatedAt == request.time;

          allow update: if canInteractBoardPost(postId) &&
            get(/databases/$(database)/documents/boardPosts/$(postId)/comments/$(commentId)).data.status == 'active' &&
            request.auth.uid == userId &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'type',
              'updatedAt'
            ]) &&
            request.resource.data.postId == resource.data.postId &&
            request.resource.data.commentId == resource.data.commentId &&
            request.resource.data.userId == resource.data.userId &&
            isCommentReactionType(request.resource.data.type) &&
            request.resource.data.createdAt == resource.data.createdAt &&
            request.resource.data.updatedAt == request.time;

          allow delete: if canInteractBoardPost(postId) &&
            get(/databases/$(database)/documents/boardPosts/$(postId)/comments/$(commentId)).data.status == 'active' &&
            request.auth.uid == userId;
        }
      }

      match /votes/{userId} {
        allow read: if canReadBoardPost(postId);

        allow create: if canInteractBoardPost(postId) &&
          request.auth.uid == userId &&
          request.resource.data.keys().hasAll([
            'postId',
            'userId',
            'type',
            'createdAt',
            'updatedAt'
          ]) &&
          request.resource.data.keys().hasOnly([
            'postId',
            'userId',
            'type',
            'createdAt',
            'updatedAt'
          ]) &&
          request.resource.data.postId == postId &&
          request.resource.data.userId == request.auth.uid &&
          isBoardVoteType(request.resource.data.type) &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.updatedAt == request.time;

        allow update: if canInteractBoardPost(postId) &&
          request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'type',
            'updatedAt'
          ]) &&
          request.resource.data.postId == resource.data.postId &&
          request.resource.data.userId == resource.data.userId &&
          isBoardVoteType(request.resource.data.type) &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.updatedAt == request.time;

        allow delete: if canInteractBoardPost(postId) && request.auth.uid == userId;
      }
    }

    match /boardMemberships/{membershipId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        request.auth.uid == resource.data.userId ||
        canReadBoardPost(resource.data.postId)
      );

      allow create, update: if isSignedIn() &&
        request.resource.data.keys().hasAll([
          'boardType',
          'userId',
          'postId',
          'jobPostingId',
          'role',
          'displayName',
          'canRead',
          'canComment',
          'title',
          'workDate',
          'authorId',
          'updatedAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'boardType',
          'userId',
          'postId',
          'jobPostingId',
          'role',
          'displayName',
          'canRead',
          'canComment',
          'title',
          'workDate',
          'authorId',
          'lastActivityAt',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.boardType == 'schedule' &&
        request.resource.data.userId is string &&
        request.resource.data.postId is string &&
        request.resource.data.jobPostingId is string &&
        membershipId == getBoardMembershipDocId(request.resource.data.postId, request.resource.data.userId) &&
        isScheduleBoardPostId(request.resource.data.postId, request.resource.data.jobPostingId) &&
        canManageLinkedJobPosting(request.resource.data.jobPostingId) &&
        request.resource.data.authorId ==
          get(/databases/$(database)/documents/jobPostings/$(request.resource.data.jobPostingId)).data.ownerId &&
        isBoardMemberRole(request.resource.data.role) &&
        (!('displayName' in request.resource.data) ||
          request.resource.data.displayName == null ||
          isValidString(request.resource.data.displayName, 80)) &&
        request.resource.data.canRead is bool &&
        request.resource.data.canComment is bool &&
        isValidString(request.resource.data.title, 120) &&
        request.resource.data.workDate is string &&
        (!('lastActivityAt' in request.resource.data) ||
          request.resource.data.lastActivityAt == null ||
          request.resource.data.lastActivityAt is timestamp) &&
        (!('createdAt' in request.resource.data) ||
          request.resource.data.createdAt == null ||
          request.resource.data.createdAt is timestamp) &&
        request.resource.data.updatedAt == request.time;

      allow delete: if isSignedIn() &&
        resource.data.boardType == 'schedule' &&
        canManageLinkedJobPosting(resource.data.jobPostingId);
    }

    match /boardReports/{reportId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        request.auth.uid == resource.data.reporterId
      );

      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.reporterId &&
        request.resource.data.keys().hasAll([
          'targetType',
          'targetId',
          'postId',
          'reporterId',
          'reason',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'targetType',
          'targetId',
          'postId',
          'reporterId',
          'reason',
          'details',
          'status',
          'createdAt',
          'updatedAt',
          'resolvedBy',
          'resolvedAt'
        ]) &&
        isBoardReportTargetType(request.resource.data.targetType) &&
        request.resource.data.targetId is string &&
        request.resource.data.postId is string &&
        (
          request.resource.data.targetType != 'post' ||
          request.resource.data.targetId == request.resource.data.postId
        ) &&
        canReadBoardReportTarget(
          request.resource.data.postId,
          request.resource.data.targetType,
          request.resource.data.targetId
        ) &&
        isSafeText(request.resource.data.reason, 80) &&
        (!('details' in request.resource.data) ||
          request.resource.data.details == null ||
          isSafeText(request.resource.data.details, 1000)) &&
        request.resource.data.status == 'pending' &&
        (!('resolvedBy' in request.resource.data) || request.resource.data.resolvedBy == null) &&
        (!('resolvedAt' in request.resource.data) || request.resource.data.resolvedAt == null) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;

      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'resolvedBy',
          'resolvedAt',
          'updatedAt'
        ]) &&
        isBoardReportStatus(request.resource.data.status) &&
        request.resource.data.status in ['resolved', 'dismissed'] &&
        request.resource.data.resolvedBy == request.auth.uid &&
        request.resource.data.resolvedAt == request.time &&
        request.resource.data.updatedAt == request.time;

      allow delete: if isAdmin();
    }

    // --- Reports Collection (신고) ---
    // v1.2.0: 양방향 신고 지원 (구인자→스태프, 구직자→구인자)
    match /reports/{reportId} {
      // 읽기: 관리자는 모든 신고, 일반 사용자는 본인 신고만
      allow read: if isSignedIn() && (
        isPrivileged() ||
        request.auth.uid == resource.data.reporterId
      );

      // 생성: 로그인한 사용자가 신고 생성 가능
      // 양방향 신고 타입 지원:
      //   - 스태프 신고 (employer→employee): tardiness, negligence, no_show, early_leave, inappropriate, dress_code, communication, other
      //   - 구인자 신고 (employee→employer): false_posting, employer_negligence, unfair_treatment, inappropriate_behavior, other
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.reporterId &&
        request.resource.data.keys().hasAll(['reporterId', 'reporterName', 'targetId', 'targetName', 'jobPostingId', 'type', 'description', 'reporterType', 'severity', 'status']) &&
        isSafeText(request.resource.data.description, 2000) &&
        request.resource.data.type in [
          // 스태프 신고 유형
          'tardiness', 'negligence', 'no_show', 'early_leave', 'inappropriate', 'dress_code', 'communication',
          // 구인자 신고 유형
          'false_posting', 'employer_negligence', 'unfair_treatment', 'inappropriate_behavior',
          // 공통
          'other'
        ] &&
        request.resource.data.reporterType in ['employer', 'employee'] &&
        request.resource.data.severity in ['low', 'medium', 'high', 'critical'] &&
        request.resource.data.status == 'pending' &&
        request.resource.data.reporterId is string &&
        request.resource.data.reporterName is string &&
        request.resource.data.targetId is string &&
        request.resource.data.targetName is string &&
        request.resource.data.jobPostingId is string &&
        (!('jobPostingTitle' in request.resource.data) || request.resource.data.jobPostingTitle is string) &&
        (!('workLogId' in request.resource.data) || request.resource.data.workLogId is string) &&
        (!('workDate' in request.resource.data) || request.resource.data.workDate is string) &&
        (!('evidenceUrls' in request.resource.data) || request.resource.data.evidenceUrls is list);

      // 수정: 관리자만 가능 (상태 변경 등)
      allow update: if isPrivileged();

      // 삭제: 관리자만 가능
      allow delete: if isPrivileged();
    }

    // --- Staff-based QR Attendance System Collections (v2.0) ---

    // User QR Metadata Subcollection (users/{userId}/qrMetadata/{docId})
    // 각 사용자의 QR 메타데이터 (보안 코드, 통계)
    match /users/{userId}/qrMetadata/{metadataId} {
      // 읽기: 본인과 관리자만
      allow read: if isSignedIn() && (isOwner(userId) || isPrivileged());

      // 생성/수정: 본인과 관리자만
      allow create, update: if isSignedIn() && (isOwner(userId) || isPrivileged()) &&
        request.resource.data.keys().hasAll(['securityCode', 'createdAt', 'regenerationCount', 'totalScanCount']) &&
        request.resource.data.securityCode is string &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.regenerationCount is number &&
        request.resource.data.totalScanCount is number &&
        (!('lastUsedAt' in request.resource.data) || request.resource.data.lastUsedAt is timestamp) &&
        (!('lastRegeneratedAt' in request.resource.data) || request.resource.data.lastRegeneratedAt is timestamp);

      // 삭제: 관리자만
      allow delete: if isAdmin();
    }

    // Scan History Collection (스캔 이력)
    match /scanHistory/{historyId} {
      // 읽기: 본인의 이력, 관련 이벤트 관리자, 또는 전체 관리자
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.staffId ||
        request.auth.uid == resource.data.scannedBy ||
        isPrivileged()
      );

      // 생성: 모든 인증된 사용자 (스캔 시 자동 생성)
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasAll(['staffId', 'staffName', 'eventId', 'date', 'mode', 'scannedAt', 'workLogId', 'scannedBy']) &&
        request.resource.data.staffId is string &&
        request.resource.data.staffName is string &&
        request.resource.data.eventId is string &&
        request.resource.data.date is string &&
        request.resource.data.mode in ['check-in', 'check-out'] &&
        request.resource.data.scannedAt is timestamp &&
        request.resource.data.workLogId is string &&
        request.resource.data.scannedBy is string &&
        (!('deviceInfo' in request.resource.data) || request.resource.data.deviceInfo is string) &&
        (!('location' in request.resource.data) || request.resource.data.location is map);

      // 수정/삭제: 관리자만
      allow update, delete: if isAdmin();
    }

    // Scan Cooldowns Collection (5분 중복 스캔 방지)
    match /scanCooldowns/{cooldownId} {
      // 읽기: 모든 인증된 사용자 (중복 확인용)
      allow read: if isSignedIn();

      // 생성/수정: 모든 인증된 사용자 (스캔 시 자동 생성)
      allow create, update: if isSignedIn() &&
        request.resource.data.keys().hasAll(['key', 'staffId', 'eventId', 'date', 'mode', 'lastScanAt', 'expiresAt']) &&
        request.resource.data.key is string &&
        request.resource.data.staffId is string &&
        request.resource.data.eventId is string &&
        request.resource.data.date is string &&
        request.resource.data.mode in ['check-in', 'check-out'] &&
        request.resource.data.lastScanAt is timestamp &&
        request.resource.data.expiresAt is timestamp;

      // 삭제: 관리자만 (만료된 쿨다운 정리용)
      allow delete: if isAdmin();
    }

    // --- System Announcements Collection (시스템 공지사항) ---
    match /systemAnnouncements/{announcementId} {
      // 읽기: 모든 인증된 사용자
      allow read: if isSignedIn();

      // 생성: 관리자와 매니저만 가능
      allow create: if isPrivileged() &&
        request.resource.data.keys().hasAll(['title', 'content', 'priority', 'startDate', 'createdBy', 'createdByName', 'isActive', 'viewCount']) &&
        isSafeText(request.resource.data.title, 100) &&
        isSafeText(request.resource.data.content, 2000) &&
        request.resource.data.priority in ['normal', 'important', 'urgent'] &&
        request.resource.data.startDate is timestamp &&
        (!('endDate' in request.resource.data) || request.resource.data.endDate is timestamp || request.resource.data.endDate == null) &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.isActive is bool &&
        request.resource.data.viewCount is number;

      // 수정: 관리자와 매니저만 가능
      allow update: if isPrivileged();

      // 삭제: 관리자만 가능
      allow delete: if isAdmin();
    }

    // --- Job Posting Announcements Collection (공고별 공지) ---
    match /jobPostingAnnouncements/{announcementId} {
      // 읽기: 모든 인증된 사용자
      allow read: if isSignedIn();

      // 생성: 관리자와 매니저만 가능
      allow create: if isPrivileged();

      // 수정/삭제: 관리자만 가능
      allow update, delete: if isAdmin();
    }

    // --- Phone Verifications (전화번호 인증) ---
    match /phoneVerifications/{verificationId} {
      // 읽기: 본인의 인증만 가능
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId;

      // 생성/수정: 클라이언트 차단 (Cloud Functions만 가능)
      allow create, update: if false;

      // 삭제: 관리자만 가능
      allow delete: if isAdmin();
    }

    // --- Orphan Accounts (고아 계정 마킹 - 회원가입 롤백 실패 시) ---
    // 클라이언트에서 생성만 가능, 읽기/수정/삭제는 Cloud Functions(Admin SDK)에서만
    match /orphanAccounts/{uid} {
      // 인증된 사용자가 본인 UID 문서만 생성 가능
      allow create: if isSignedIn() && uid == request.auth.uid &&
        request.resource.data.keys().hasAll(['uid', 'reason', 'createdAt', 'platform']) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.reason is string &&
        request.resource.data.platform in ['ios', 'android', 'web'];

      // 읽기/수정/삭제: Cloud Functions(Admin SDK)에서만 가능
      allow read, update, delete: if false;
    }

    // --- [서버 전용] Pending Verifications ---
    // Cloud Functions(Admin SDK)에서만 접근. 클라이언트 접근 차단.
    // 포트원 V2 본인인증 임시 저장 (TTL 30분, 스케줄러 자동 정리)
    match /pendingVerifications/{verificationId} {
      allow read, write: if false;
    }

    // --- [서버 전용] CI Index ---
    // Cloud Functions(Admin SDK)에서만 접근. 클라이언트 접근 차단.
    // CI 기반 중복가입 방지 인덱스
    match /ciIndex/{ciHash} {
      allow read, write: if false;
    }

    // ================= 모바일 앱 지원 (v1.0.0) =================

    // --- FCM Tokens (푸시 알림 토큰) ---
    match /fcmTokens/{tokenId} {
      // 읽기: 본인의 토큰만 가능, 관리자는 전체 조회 가능
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.userId ||
        isPrivileged()
      );

      // 생성: 본인의 토큰만 등록 가능
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.userId &&
        request.resource.data.keys().hasAll(['userId', 'token', 'platform', 'createdAt']) &&
        request.resource.data.token is string &&
        request.resource.data.platform in ['ios', 'android', 'web'] &&
        request.resource.data.createdAt is timestamp &&
        (!('deviceId' in request.resource.data) || request.resource.data.deviceId is string) &&
        (!('appVersion' in request.resource.data) || request.resource.data.appVersion is string);

      // 수정: 본인의 토큰만 수정 가능
      allow update: if isSignedIn() && request.auth.uid == resource.data.userId;

      // 삭제: 본인 또는 관리자만 가능
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.userId ||
        isPrivileged()
      );
    }

    // --- Device Sessions (디바이스 세션 관리) ---
    match /deviceSessions/{sessionId} {
      // 읽기: 본인의 세션만 가능
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId;

      // 생성: 본인의 세션만 생성 가능
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.userId &&
        request.resource.data.keys().hasAll(['userId', 'deviceId', 'platform', 'createdAt', 'lastActiveAt']) &&
        request.resource.data.deviceId is string &&
        request.resource.data.platform in ['ios', 'android', 'web'] &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.lastActiveAt is timestamp;

      // 수정: 본인의 세션만 수정 가능 (lastActiveAt 업데이트 등)
      allow update: if isSignedIn() && request.auth.uid == resource.data.userId;

      // 삭제: 본인의 세션만 삭제 가능 (로그아웃)
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }

    // --- User Notification Settings (사용자 알림 설정) ---
    match /users/{userId}/notificationSettings/{settingId} {
      // 읽기: 본인만 가능
      allow read: if isSignedIn() && isOwner(userId);

      // 생성/수정: 본인만 가능
      allow create, update: if isSignedIn() && isOwner(userId) &&
        (!('pushEnabled' in request.resource.data) || request.resource.data.pushEnabled is bool) &&
        (!('emailEnabled' in request.resource.data) || request.resource.data.emailEnabled is bool) &&
        (!('categories' in request.resource.data) || request.resource.data.categories is map) &&
        (!('quietHours' in request.resource.data) || request.resource.data.quietHours is map);

      // 삭제: 본인만 가능
      allow delete: if isSignedIn() && isOwner(userId);
    }

    // --- App Versions (앱 버전 관리 - 강제 업데이트용) ---
    match /appVersions/{platform} {
      // 읽기: 모든 사용자 (버전 확인용)
      allow read: if true;

      // 생성/수정/삭제: 관리자만 가능
      allow create, update, delete: if isAdmin();
    }

    // --- Feature Flags (기능 플래그) ---
    match /featureFlags/{flagId} {
      // 읽기: 모든 인증된 사용자
      allow read: if isSignedIn();

      // 생성/수정/삭제: 관리자만 가능
      allow create, update, delete: if isAdmin();
    }

    // --- App Analytics (앱 분석 데이터) ---
    match /appAnalytics/{analyticsId} {
      // 읽기: 관리자만 가능
      allow read: if isPrivileged();

      // 생성: 모든 인증된 사용자 (익명 분석 데이터)
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasAll(['event', 'timestamp', 'platform']) &&
        request.resource.data.event is string &&
        request.resource.data.timestamp is timestamp &&
        request.resource.data.platform in ['ios', 'android', 'web'] &&
        (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid);

      // 수정/삭제: 불가 (분석 데이터 보존)
      allow update, delete: if false;
    }

    // --- Crash Reports (크래시 리포트) ---
    match /crashReports/{reportId} {
      // 읽기: 관리자만 가능
      allow read: if isPrivileged();

      // 생성: 모든 인증된 사용자 (크래시 발생 시 자동 생성)
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasAll(['error', 'stack', 'timestamp', 'platform', 'appVersion']) &&
        request.resource.data.error is string &&
        request.resource.data.timestamp is timestamp &&
        request.resource.data.platform in ['ios', 'android', 'web'] &&
        request.resource.data.appVersion is string;

      // 수정: 관리자만 가능 (상태 변경)
      allow update: if isPrivileged();

      // 삭제: 관리자만 가능
      allow delete: if isAdmin();
    }

    // --- User Favorites (사용자 즐겨찾기 - 공고) ---
    match /users/{userId}/favorites/{favoriteId} {
      // 읽기: 본인만 가능
      allow read: if isSignedIn() && isOwner(userId);

      // 생성: 본인만 가능
      allow create: if isSignedIn() && isOwner(userId) &&
        request.resource.data.keys().hasAll(['jobPostingId', 'createdAt']) &&
        request.resource.data.jobPostingId is string &&
        request.resource.data.createdAt is timestamp;

      // 삭제: 본인만 가능
      allow delete: if isSignedIn() && isOwner(userId);

      // 수정: 불필요 (즐겨찾기는 추가/삭제만)
      allow update: if false;
    }

    // --- User Search History (검색 기록) ---
    match /users/{userId}/searchHistory/{historyId} {
      // 읽기: 본인만 가능
      allow read: if isSignedIn() && isOwner(userId);

      // 생성: 본인만 가능
      allow create: if isSignedIn() && isOwner(userId) &&
        request.resource.data.keys().hasAll(['query', 'createdAt']) &&
        isSafeText(request.resource.data.query, 100) &&
        request.resource.data.createdAt is timestamp;

      // 삭제: 본인만 가능 (검색 기록 삭제)
      allow delete: if isSignedIn() && isOwner(userId);

      // 수정: 불필요
      allow update: if false;
    }

    // --- Event QR Codes (현장 출퇴근 QR 코드) ---
    // 스태프의 QR 스캔 검증은 QR JSON 파싱으로 처리 (Firestore 직접 읽기 불필요)
    match /eventQRCodes/{qrId} {
      // 읽기: 관리자 또는 공고 소유자만 가능
      allow read: if isSignedIn() && (
        isPrivileged() ||
        (hasValidRole() &&
         exists(/databases/$(database)/documents/jobPostings/$(resource.data.jobPostingId)) &&
         get(/databases/$(database)/documents/jobPostings/$(resource.data.jobPostingId)).data.ownerId == request.auth.uid)
      );

      // 생성: 구인자/관리자 + 공고 소유자 확인
      // v2.0: eventId → jobPostingId 필드명 정규화
      allow create: if isSignedIn() && isPrivileged() &&
        request.resource.data.keys().hasAll(['jobPostingId', 'date', 'action', 'securityCode', 'createdBy', 'createdAt', 'expiresAt', 'isActive']) &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.jobPostingId is string &&
        request.resource.data.date is string &&
        request.resource.data.action in ['checkIn', 'checkOut'] &&
        request.resource.data.securityCode is string &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.isActive is bool &&
        exists(/databases/$(database)/documents/jobPostings/$(request.resource.data.jobPostingId)) &&
        get(/databases/$(database)/documents/jobPostings/$(request.resource.data.jobPostingId)).data.ownerId == request.auth.uid;

      // 수정: 공고 작성자 또는 관리자 (isActive 변경만)
      // v2.0: eventId → jobPostingId 필드명 정규화
      allow update: if isSignedIn() && (
        isAdmin() ||
        (isPrivileged() &&
         exists(/databases/$(database)/documents/jobPostings/$(resource.data.jobPostingId)) &&
         get(/databases/$(database)/documents/jobPostings/$(resource.data.jobPostingId)).data.ownerId == request.auth.uid)
      ) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isActive']);

      // 삭제: 관리자만
      allow delete: if isAdmin();
    }

    // --- Reviews Collection (버블 상호 평가) ---
    // 문서 ID: `{workLogId}_{reviewerType}` (결정적 ID)
    // 평가는 생성 후 수정/삭제 불가 (불변)
    match /reviews/{reviewId} {
      // 읽기: 블라인드 조회 규칙
      // 1. 본인이 작성한 리뷰 (항상 읽기 가능)
      // 2. 본인이 피평가자 (list 쿼리 허용 — 블라인드는 앱 레벨에서 처리)
      // 3. 본인이 피평가자 + get() 단건 조회 시 블라인드 해제 조건 검증
      // 4. 관리자
      allow read: if isSignedIn() && (
        resource.data.reviewerId == request.auth.uid ||
        resource.data.revieweeId == request.auth.uid ||
        isAdmin()
      );

      // 생성: 본인의 평가만 가능 + 필수 필드 검증
      allow create: if isSignedIn() &&
        request.resource.data.reviewerId == request.auth.uid &&
        request.resource.data.keys().hasAll([
          'workLogId', 'jobPostingId', 'jobPostingTitle', 'workDate',
          'reviewerId', 'reviewerName', 'reviewerType',
          'revieweeId', 'revieweeName',
          'sentiment', 'tags', 'bubbleScoreChange', 'createdAt'
        ]) &&
        request.resource.data.reviewerType in ['employer', 'staff'] &&
        request.resource.data.sentiment in ['positive', 'neutral', 'negative'] &&
        request.resource.data.tags is list &&
        request.resource.data.tags.size() >= 1 &&
        request.resource.data.tags.size() <= 5 &&
        request.resource.data.bubbleScoreChange in [-1.0, -1, 0, 0.0, 1.0, 1] &&
        request.resource.data.reviewerId != request.resource.data.revieweeId &&
        (!('comment' in request.resource.data) || (
          request.resource.data.comment is string &&
          request.resource.data.comment.size() <= 200 &&
          hasNoXSS(request.resource.data.comment)
        ));

      // 수정/삭제: 불가 (평가는 불변)
      allow update, delete: if false;
    }

    // --- In-App Messages (인앱 메시지) ---
    // 서버(Cloud Functions/Admin SDK)에서만 생성·수정·삭제 가능
    // 클라이언트는 활성 메시지 읽기만 가능
    match /inAppMessages/{messageId} {
      // 읽기: 모든 인증된 사용자
      allow read: if isSignedIn();

      // 생성/수정/삭제: 관리자만 가능
      allow create, update, delete: if isAdmin();
    }

    // Fallback rule: deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
