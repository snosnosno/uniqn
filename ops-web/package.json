{
  "name": "ops-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --mode development",
    "build:prod": "tsc -b && vite build --mode production",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality": "npm run sync:check && npm run typecheck && npm run lint && npm run format:check && npm run test",
    "sync:core": "node ../scripts/sync-ops-core.mjs",
    "sync:check": "node ../scripts/sync-ops-core.mjs --check",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:local-db": "node scripts/check-local-supabase.mjs",
    "seed:local": "node scripts/seed-local.mjs",
    "cf:dev": "wrangler dev --local",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static"
  },
  "dependencies": {
    "@fontsource-variable/big-shoulders-display": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@sun-typeface/suit": "^2.0.5",
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.48.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.4",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "uqr": "^0.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.9",
    "shadcn": "^4.21.0",
    "storybook": "^10.6.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.2",
    "wrangler": "^4.142.0"
  }
}
